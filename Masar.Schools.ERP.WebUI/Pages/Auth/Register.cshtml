@page
@model RegisterModel
@{
    ViewData["Title"] = "تسجيل مستخدم جديد - نظام مَسَر للمدارس";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="~/css/fonts.css" rel="stylesheet">
    <link href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link href="~/lib/fontawesome/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --masar-primary: #1a5f7a;
            --masar-secondary: #159895;
            --masar-accent: #57c5b6;
            --masar-light: #f0f8ff;
            --masar-dark: #0d3b4c;
        }

        body {
            background: linear-gradient(135deg, var(--masar-primary) 0%, var(--masar-secondary) 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .register-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .register-card {
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            overflow: hidden;
            max-width: 900px;
            width: 100%;
        }

        .register-header {
            background: linear-gradient(135deg, var(--masar-primary) 0%, var(--masar-secondary) 100%);
            color: white;
            padding: 40px;
            text-align: center;
        }

        .masar-logo {
            font-size: 3rem;
            margin-bottom: 20px;
            color: white;
        }

        .masar-title {
            font-size: 2.5rem;
            font-weight: bold;
            margin-bottom: 10px;
        }

        .masar-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
        }

        .register-body {
            padding: 40px;
        }

        .form-floating > label {
            right: 0;
            left: auto;
        }

        .btn-masar {
            background: linear-gradient(135deg, var(--masar-primary) 0%, var(--masar-secondary) 100%);
            border: none;
            color: white;
            padding: 12px 30px;
            border-radius: 10px;
            font-weight: bold;
            transition: all 0.3s ease;
        }

        .btn-masar:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(21, 152, 149, 0.4);
            color: white;
        }

        .forgot-password {
            color: var(--masar-secondary);
            text-decoration: none;
            transition: color 0.3s ease;
        }

        .forgot-password:hover {
            color: var(--masar-primary);
        }

        .alert-masar {
            border-radius: 10px;
            border: none;
        }
    </style>
</head>
<body>
    <div class="register-container">
        <div class="register-card">
            <div class="register-header">
                <div class="masar-logo">
                    <i class="fas fa-user-plus"></i>
                </div>
                <h1 class="masar-title">مَسَار للمدارس</h1>
                <p class="masar-subtitle">تسجيل مستخدم جديد</p>
            </div>

            <div class="register-body">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger alert-masar mb-4">
                        <i class="fas fa-exclamation-circle me-2"></i>
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    </div>
                }

                <form method="post">
                    <div class="mb-3">
                        <label asp-for="Input.Email" class="form-label">البريد الإلكتروني</label>
                        <input asp-for="Input.Email" class="form-control" required />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.Password" class="form-label">كلمة المرور</label>
                        <input asp-for="Input.Password" class="form-control" type="password" required />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.ConfirmPassword" class="form-label">تأكيد كلمة المرور</label>
                        <input asp-for="Input.ConfirmPassword" class="form-control" type="password" required />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.FirstName" class="form-label">الاسم الأول</label>
                        <input asp-for="Input.FirstName" class="form-control" required />
                        <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.LastName" class="form-label">اسم العائلة</label>
                        <input asp-for="Input.LastName" class="form-control" required />
                        <span asp-validation-for="Input.LastName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Input.PhoneNumber" class="form-label">رقم الهاتف</label>
                        <input asp-for="Input.PhoneNumber" class="form-control" />
                        <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-masar w-100 btn-lg">
                        <i class="fas fa-user-plus me-2"></i>
                        تسجيل
                    </button>

                    <div class="text-center mt-4">
                        <a asp-page="/Auth/Login" class="forgot-password">
                            <i class="fas fa-sign-in-alt me-1"></i>
                            لديك حساب بالفعل؟ سجل دخول
                        </a>
                    </div>
                </form>

                <div class="text-center mt-4">
                    <p class="text-muted">
                        <i class="fas fa-shield-alt me-1"></i>
                        نظام آمن ومحمي بأحدث تقنيات التشفير
                    </p>
                    <p class="text-muted small">
                        © 2026 نظام مَسَار للمدارس - بوابتك الآمنة للإدارة المدرسية الذكية
                    </p>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
