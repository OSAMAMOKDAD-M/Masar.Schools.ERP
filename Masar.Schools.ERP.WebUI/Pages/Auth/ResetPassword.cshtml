@page
@model Masar.Schools.ERP.WebUI.Pages.Auth.ResetPasswordModel
@{
    ViewData["Title"] = "إعادة تعيين كلمة المرور - مَسَار للمدارس";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="~/css/fonts.css" rel="stylesheet">
    <link href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link href="~/lib/fontawesome/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --masar-primary: #1a5f7a;
            --masar-secondary: #159895;
            --masar-accent: #57c5b6;
            --masar-light: #f0f8ff;
            --masar-dark: #0d3b4c;
        }

        body {
            font-family: 'Cairo', 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, var(--masar-light) 0%, #e8f4f8 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-container {
            max-width: 450px;
            width: 100%;
            padding: 2rem;
        }

        .login-card {
            background: white;
            border-radius: 20px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
            padding: 2.5rem;
            border-top: 5px solid var(--masar-primary);
        }

        .logo-section {
            text-align: center;
            margin-bottom: 2rem;
        }

        .logo-icon {
            font-size: 3rem;
            color: var(--masar-primary);
            margin-bottom: 1rem;
        }

        .app-title {
            font-size: 1.8rem;
            font-weight: 700;
            color: var(--masar-primary);
            margin-bottom: 0.5rem;
        }

        .app-subtitle {
            font-size: 0.9rem;
            color: var(--masar-secondary);
        }

        .form-floating > .form-control:focus ~ label {
            color: var(--masar-primary);
        }

        .form-floating > .form-control:not(:placeholder-shown) ~ label {
            color: var(--masar-dark);
        }

        .btn-primary {
            background: linear-gradient(135deg, var(--masar-primary) 0%, var(--masar-secondary) 100%);
            border: none;
            padding: 0.75rem;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(26, 95, 122, 0.3);
        }

        .btn-primary:disabled {
            background: var(--masar-dark);
            transform: none;
        }

        .back-link {
            color: var(--masar-primary);
            text-decoration: none;
            font-weight: 500;
            transition: color 0.3s ease;
        }

        .back-link:hover {
            color: var(--masar-secondary);
        }

        .alert {
            border-radius: 10px;
            border: none;
        }

        .alert-success {
            background-color: #d4edda;
            color: #155724;
        }

        .alert-danger {
            background-color: #f8d7da;
            color: #721c24;
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="login-card">
            <div class="logo-section">
                <div class="logo-icon">
                    <i class="fas fa-key"></i>
                </div>
                <h1 class="app-title">نظام مَسَار للمدارس</h1>
                <p class="app-subtitle">إعادة تعيين كلمة المرور</p>
            </div>

            <form method="post">
                <div asp-validation-summary="All" class="alert alert-danger mb-3"></div>

                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="email" aria-required="true" disabled />
                    <label asp-for="Input.Email" class="form-label">البريد الإلكتروني</label>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder=" " />
                    <label asp-for="Input.Password" class="form-label">كلمة المرور الجديدة</label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder=" " />
                    <label asp-for="Input.ConfirmPassword" class="form-label">تأكيد كلمة المرور الجديدة</label>
                    <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-primary w-100 mb-3">
                    <i class="fas fa-save me-2"></i>
                    حفظ كلمة المرور الجديدة
                </button>

                <div class="text-center">
                    <a asp-page="./Login" class="back-link">
                        <i class="fas fa-arrow-right me-2"></i>
                        العودة إلى تسجيل الدخول
                    </a>
                </div>
            </form>
        </div>

        <div class="text-center mt-4">
            <p class="text-muted small">
                © 2026 مَسَار للمدارس - جميع الحقوق محفوظة - شركة مسار للبرمجيات mokdadvipr@gmail.com .. 01006765664
            </p>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
