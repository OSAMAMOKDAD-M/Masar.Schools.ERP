@page
@model Masar.Schools.ERP.WebUI.Pages.Chat.IndexModel
@{
    ViewData["Title"] = "الدردشة - نظام مَسَار للمدارس";
    Layout = "_Layout";
}

<div class="container-fluid">
    <div class="row">
        <!-- Chat Rooms List -->
        <div class="col-md-4 col-lg-3 border-end">
            <div class="p-3">
                <h5 class="mb-3">الغرف</h5>
                <div class="input-group mb-3">
                    <input type="text" class="form-control" placeholder="بحث عن غرفة..." id="searchRooms">
                    <button class="btn btn-outline-secondary" type="button">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
                <div id="roomsList" class="list-group">
                    <!-- Rooms will be loaded here dynamically -->
                </div>
            </div>
        </div>

        <!-- Chat Area -->
        <div class="col-md-8 col-lg-9">
            <div class="d-flex flex-column h-100">
                <!-- Chat Header -->
                <div class="p-3 border-bottom bg-light">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <h5 id="currentRoomName" class="mb-0">اختر غرفة للدردشة</h5>
                            <small id="currentRoomStatus" class="text-muted"></small>
                        </div>
                        <div class="dropdown">
                            <button class="btn btn-link" data-bs-toggle="dropdown">
                                <i class="fas fa-ellipsis-v"></i>
                            </button>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" href="#"><i class="fas fa-info-circle me-2"></i>معلومات الغرفة</a></li>
                                <li><a class="dropdown-item" href="#"><i class="fas fa-users me-2"></i>الأعضاء</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" href="#"><i class="fas fa-sign-out-alt me-2"></i>مغادرة الغرفة</a></li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Messages Area -->
                <div class="flex-grow-1 overflow-auto p-3" id="messagesContainer" style="min-height: 400px;">
                    <div id="welcomeMessage" class="text-center text-muted py-5">
                        <i class="fas fa-comments fa-3x mb-3"></i>
                        <p>مرحباً بك في نظام مَسَار للدردشة</p>
                        <p>اختر غرفة من القائمة للبدء</p>
                    </div>
                    <div id="messagesList" class="d-none">
                        <!-- Messages will be loaded here dynamically -->
                    </div>
                </div>

                <!-- Message Input -->
                <div class="p-3 border-top bg-light">
                    <div class="input-group">
                        <button class="btn btn-outline-secondary" type="button">
                            <i class="fas fa-paperclip"></i>
                        </button>
                        <input type="text" class="form-control" placeholder="اكتب رسالتك هنا..." id="messageInput" disabled>
                        <button class="btn btn-outline-secondary" type="button">
                            <i class="fas fa-smile"></i>
                        </button>
                        <button class="btn btn-primary" type="button" id="sendMessageBtn" disabled>
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Typing Indicator -->
<div id="typingIndicator" class="d-none position-fixed bottom-0 end-0 p-3">
    <div class="bg-white shadow rounded p-2">
        <small class="text-muted">
            <i class="fas fa-ellipsis-h"></i> يكتب الآن...
        </small>
    </div>
</div>

@section Scripts {
    <script src="~/js/microsoft/signalr/dist/browser/signalr.min.js"></script>
    <script>
        let connection;
        let currentRoomId = null;
        let currentUserId = '@Model.CurrentUserId';

        document.addEventListener('DOMContentLoaded', function() {
            initializeSignalR();
            loadChatRooms();
        });

        function initializeSignalR() {
            connection = new signalR.HubConnectionBuilder()
                .withUrl("/chathub")
                .configureLogging(signalR.LogLevel.Information)
                .build();

            connection.on("ReceiveMessage", function(senderId, message, timestamp) {
                addMessageToChat(senderId, message, timestamp, senderId !== currentUserId);
            });

            connection.on("UserJoined", function(connectionId) {
                showSystemMessage("انضم مستخدم جديد إلى الغرفة");
            });

            connection.on("UserLeft", function(connectionId) {
                showSystemMessage("غادر مستخدم الغرفة");
            });

            connection.on("UserTyping", function(userId, isTyping) {
                if (isTyping && userId !== currentUserId) {
                    document.getElementById('typingIndicator').classList.remove('d-none');
                } else {
                    document.getElementById('typingIndicator').classList.add('d-none');
                }
            });

            connection.start().catch(function(err) {
                console.error("SignalR connection error:", err);
                showErrorMessage("فشل الاتصال بخادم الدردشة");
            });
        }

        function loadChatRooms() {
            // In a real implementation, this would load from API
            const rooms = [
                { id: '1', name: 'العمليات اليومية', nameArabic: 'العمليات اليومية', type: 'Group' },
                { id: '2', name: 'إدارة المدرسة', nameArabic: 'إدارة المدرسة', type: 'Group' },
                { id: '3', name: 'دعم فني', nameArabic: 'دعم فني', type: 'Group' }
            ];

            const roomsList = document.getElementById('roomsList');
            roomsList.innerHTML = '';

            rooms.forEach(room => {
                const roomElement = document.createElement('a');
                roomElement.href = '#';
                roomElement.className = 'list-group-item list-group-item-action';
                roomElement.innerHTML = `
                    <div class="d-flex w-100 justify-content-between">
                        <h6 class="mb-1">${room.nameArabic}</h6>
                        <small class="text-muted">الآن</small>
                    </div>
                    <small class="text-muted">${room.type === 'Group' ? 'مجموعة' : 'دردشة خاصة'}</small>
                `;
                roomElement.onclick = function(e) {
                    e.preventDefault();
                    joinRoom(room.id, room.nameArabic);
                };
                roomsList.appendChild(roomElement);
            });
        }

        function joinRoom(roomId, roomName) {
            if (currentRoomId) {
                connection.invoke("LeaveRoom", currentRoomId).catch(function(err) {
                    console.error("Error leaving room:", err);
                });
            }

            currentRoomId = roomId;
            document.getElementById('currentRoomName').textContent = roomName;
            document.getElementById('currentRoomStatus').textContent = 'متصل';
            document.getElementById('messageInput').disabled = false;
            document.getElementById('sendMessageBtn').disabled = false;
            document.getElementById('welcomeMessage').classList.add('d-none');
            document.getElementById('messagesList').classList.remove('d-none');
            document.getElementById('messagesList').innerHTML = '';

            connection.invoke("JoinRoom", roomId).catch(function(err) {
                console.error("Error joining room:", err);
                showErrorMessage("فشل الانضمام إلى الغرفة");
            });
        }

        function addMessageToChat(senderId, message, timestamp, isReceived) {
            const messagesList = document.getElementById('messagesList');
            const messageElement = document.createElement('div');
            messageElement.className = isReceived ? 'message received mb-3' : 'message sent mb-3';
            
            const time = new Date(timestamp).toLocaleTimeString('ar-SA', { hour: '2-digit', minute: '2-digit' });
            
            messageElement.innerHTML = `
                <div class="card ${isReceived ? 'bg-light' : 'bg-primary text-white'}">
                    <div class="card-body py-2">
                        <p class="mb-1">${message}</p>
                        <small class="${isReceived ? 'text-muted' : 'text-white-50'}">${time}</small>
                    </div>
                </div>
            `;
            
            messagesList.appendChild(messageElement);
            messagesList.scrollTop = messagesList.scrollHeight;
        }

        function showSystemMessage(message) {
            const messagesList = document.getElementById('messagesList');
            const messageElement = document.createElement('div');
            messageElement.className = 'text-center text-muted my-2';
            messageElement.innerHTML = `<small>${message}</small>`;
            messagesList.appendChild(messageElement);
            messagesList.scrollTop = messagesList.scrollHeight;
        }

        function showErrorMessage(message) {
            alert(message);
        }

        document.getElementById('sendMessageBtn').addEventListener('click', sendMessage);
        document.getElementById('messageInput').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                sendMessage();
            }
        });

        document.getElementById('messageInput').addEventListener('input', function() {
            if (currentRoomId) {
                connection.invoke("Typing", currentRoomId, currentUserId, true).catch(function(err) {
                    console.error("Error sending typing indicator:", err);
                });
            }
        });

        function sendMessage() {
            const messageInput = document.getElementById('messageInput');
            const message = messageInput.value.trim();

            if (message && currentRoomId) {
                connection.invoke("SendMessage", currentUserId, "receiver", message, currentRoomId)
                    .then(function() {
                        messageInput.value = '';
                    })
                    .catch(function(err) {
                        console.error("Error sending message:", err);
                        showErrorMessage("فشل إرسال الرسالة");
                    });
            }
        }
    </script>
}