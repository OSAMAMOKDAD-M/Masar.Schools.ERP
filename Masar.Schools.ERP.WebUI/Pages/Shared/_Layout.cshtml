<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - نظام مَسَار للمدارس</title>
    <link href="~/css/fonts.css" rel="stylesheet">
    <link href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link href="~/lib/fontawesome/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --masar-primary: #1a5f7a;
            --masar-secondary: #159895;
            --masar-accent: #57c5b6;
            --masar-light: #f0f8ff;
            --masar-dark: #0d3b4c;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f8f9fa;
        }

        .navbar-masar {
            background: linear-gradient(135deg, var(--masar-primary) 0%, var(--masar-secondary) 100%);
        }

        .navbar-brand {
            font-weight: bold;
            font-size: 1.5rem;
        }

        .sidebar {
            background: white;
            min-height: calc(100vh - 56px);
            box-shadow: 2px 0 5px rgba(0,0,0,0.1);
        }

        .sidebar .nav-link {
            color: var(--masar-dark);
            padding: 12px 20px;
            border-radius: 0 25px 25px 0;
            margin-bottom: 5px;
            transition: all 0.3s ease;
        }

        .sidebar .nav-link:hover,
        .sidebar .nav-link.active {
            background: var(--masar-light);
            color: var(--masar-primary);
            padding-right: 25px;
        }

        .sidebar .nav-link i {
            width: 25px;
        }

        .card-masar {
            border: none;
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.1);
            transition: transform 0.3s ease;
        }

        .card-masar:hover {
            transform: translateY(-5px);
        }

        .stat-card {
            background: linear-gradient(135deg, var(--masar-primary) 0%, var(--masar-secondary) 100%);
            color: white;
        }

        .btn-masar {
            background: linear-gradient(135deg, var(--masar-primary) 0%, var(--masar-secondary) 100%);
            border: none;
            color: white;
            border-radius: 10px;
            transition: all 0.3s ease;
        }

        .btn-masar:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(21, 152, 149, 0.4);
            color: white;
        }

        .footer-masar {
            background: var(--masar-dark);
            color: white;
            padding: 20px 0;
            margin-top: auto;
        }

        .message.sent .card {
            background: var(--masar-primary);
            color: white;
            margin-right: auto;
            margin-left: 0;
        }

        .message.received .card {
            background: #e9ecef;
            margin-left: auto;
            margin-right: 0;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark navbar-masar">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">
                <i class="fas fa-graduation-cap me-2"></i>
                مَسَار للمدارس
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/Dashboard">الرئيسية</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Chat">الدردشة</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Students">الطلاب</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Attendance">الحضور</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Invoices">الفواتير</a>
                    </li>
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
                            <i class="fas fa-user-circle me-1"></i>
                            @User.Identity?.Name
                        </a>
                        <ul class="dropdown-menu dropdown-menu-start">
                            <li><a class="dropdown-item" href="/Profile"><i class="fas fa-user me-2"></i>الملف الشخصي</a></li>
                            <li><a class="dropdown-item" href="/Settings"><i class="fas fa-cog me-2"></i>الإعدادات</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="/Auth/Logout"><i class="fas fa-sign-out-alt me-2"></i>تسجيل الخروج</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container-fluid">
        <div class="row">
            <div class="col-md-2 sidebar d-none d-md-block">
                <nav class="nav flex-column mt-3">
                    <a class="nav-link active" href="/Dashboard">
                        <i class="fas fa-home me-2"></i>الرئيسية
                    </a>
                    <a class="nav-link" href="/Chat">
                        <i class="fas fa-comments me-2"></i>الدردشة
                    </a>
                    <a class="nav-link" href="/Students">
                        <i class="fas fa-user-graduate me-2"></i>الطلاب
                    </a>
                    <a class="nav-link" href="/Guardians">
                        <i class="fas fa-users me-2"></i>أولياء الأمور
                    </a>
                    <a class="nav-link" href="/Employees">
                        <i class="fas fa-chalkboard-teacher me-2"></i>الموظفون
                    </a>
                    <a class="nav-link" href="/Attendance">
                        <i class="fas fa-fingerprint me-2"></i>الحضور
                    </a>
                    <a class="nav-link" href="/Grades">
                        <i class="fas fa-graduation-cap me-2"></i>الدرجات
                    </a>
                    <a class="nav-link" href="/Invoices">
                        <i class="fas fa-file-invoice-dollar me-2"></i>الفواتير
                    </a>
                    <a class="nav-link" href="/Reports">
                        <i class="fas fa-chart-bar me-2"></i>التقارير
                    </a>
                    <a class="nav-link" href="/Settings">
                        <i class="fas fa-cog me-2"></i>الإعدادات
                    </a>
                </nav>
            </div>
            <div class="col-md-10 col-12 py-4">
                @RenderBody()
            </div>
        </div>
    </div>

    <footer class="footer-masar">
        <div class="container-fluid text-center">
            <p class="mb-0">© 2026 نظام مَسَار للمدارس - جميع الحقوق محفوظة - شركة مسار للبرمجيات mokdadvipr@gmail.com .. 01006765664</p>
            <small class="text-white-50">نسخة 1.0.0</small>
        </div>
    </footer>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>