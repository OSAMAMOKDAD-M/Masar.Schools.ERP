@model IEnumerable<Masar.Schools.ERP.Domain.DTOs.AcademicTermDto>
@{
    ViewData["Title"] = "إدارة الفصول الدراسية";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">إدارة الفصول الدراسية</h3>
                    <div class="card-tools">
                        <a href="@Url.Action("Open", "AcademicTerm")" class="btn btn-primary">
                            <i class="fas fa-plus"></i> فتح فصل دراسي جديد
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-md-3">
                            <div class="info-box bg-info">
                                <span class="info-box-icon"><i class="fas fa-calendar-alt"></i></span>
                                <div class="info-box-content">
                                    <span class="info-box-text">إجمالي الفصول</span>
                                    <span class="info-box-number">@(Model?.Count() ?? 0)</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="info-box bg-success">
                                <span class="info-box-icon"><i class="fas fa-check-circle"></i></span>
                                <div class="info-box-content">
                                    <span class="info-box-text">نشط</span>
                                    <span class="info-box-number">@(Model?.Count(t => t.IsActive) ?? 0)</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="info-box bg-secondary">
                                <span class="info-box-icon"><i class="fas fa-pause-circle"></i></span>
                                <div class="info-box-content">
                                    <span class="info-box-text">غير نشط</span>
                                    <span class="info-box-number">@(Model?.Count(t => !t.IsActive) ?? 0)</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th>اسم الفصل</th>
                                    <th>المدرسة</th>
                                    <th>تاريخ البدء</th>
                                    <th>تاريخ الانتهاء</th>
                                    <th>الحالة</th>
                                    <th>تاريخ الإنشاء</th>
                                    <th>الإجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    @foreach (var term in Model)
                                    {
                                        <tr>
                                            <td>@term.TermNameArabic</td>
                                            <td>@term.SchoolName</td>
                                            <td>@term.StartDate.ToString("yyyy-MM-dd")</td>
                                            <td>@term.EndDate.ToString("yyyy-MM-dd")</td>
                                            <td>
                                                <span class="badge bg-@(term.IsActive ? "success" : "secondary")">
                                                    @term.StatusArabic
                                                </span>
                                            </td>
                                            <td>@term.CreatedAt.ToString("yyyy-MM-dd")</td>
                                            <td>
                                                <a href="@Url.Action("Details", "AcademicTerm", new { id = term.Id })" class="btn btn-sm btn-info">
                                                    <i class="fas fa-eye"></i> عرض
                                                </a>
                                                <form asp-action="Toggle" method="post" style="display: inline;">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@term.Id" />
                                                    <input type="hidden" name="isActive" value="@(term.IsActive ? "false" : "true")" />
                                                    <button type="submit" class="btn btn-sm @(term.IsActive ? "btn-warning" : "btn-success")">
                                                        <i class="fas fa-@(term.IsActive ? "pause" : "play")"></i>
                                                        @(term.IsActive ? "تعطيل" : "تفعيل")
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7" class="text-center">لا توجد فصول دراسية</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
