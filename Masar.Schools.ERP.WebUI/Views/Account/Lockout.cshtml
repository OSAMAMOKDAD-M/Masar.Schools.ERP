@{
    ViewData["Title"] = "الحساب مغلق";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="~/css/fonts.css" rel="stylesheet">
    <link href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link href="~/lib/fontawesome/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --masar-primary: #1a5f7a;
            --masar-secondary: #159895;
            --masar-accent: #57c5b6;
            --masar-light: #f0f8ff;
            --masar-dark: #0d3b4c;
        }

        body {
            background: linear-gradient(135deg, var(--masar-primary) 0%, var(--masar-secondary) 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .lockout-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .lockout-card {
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            overflow: hidden;
            max-width: 500px;
            width: 100%;
            text-align: center;
        }

        .lockout-header {
            background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
            color: white;
            padding: 40px;
        }

        .lockout-icon {
            font-size: 4rem;
            margin-bottom: 20px;
        }

        .lockout-body {
            padding: 40px;
        }

        .btn-masar {
            background: linear-gradient(135deg, var(--masar-primary) 0%, var(--masar-secondary) 100%);
            border: none;
            color: white;
            padding: 12px 30px;
            border-radius: 10px;
            font-weight: bold;
            transition: all 0.3s ease;
        }

        .btn-masar:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(21, 152, 149, 0.4);
            color: white;
        }
    </style>
</head>
<body>
    <div class="lockout-container">
        <div class="lockout-card">
            <div class="lockout-header">
                <div class="lockout-icon">
                    <i class="fas fa-lock"></i>
                </div>
                <h2>الحساب مغلق</h2>
            </div>

            <div class="lockout-body">
                <div class="alert alert-warning">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    تم قفل حسابك بسبب محاولات دخول خاطئة متعددة
                </div>

                <p class="mb-4">
                    يرجى الانتظار لمدة 15 دقيقة قبل المحاولة مرة أخرى، أو التواصل مع الإدارة لفتح الحساب.
                </p>

                <a asp-action="Login" class="btn btn-masar w-100">
                    <i class="fas fa-home me-2"></i>
                    العودة إلى الصفحة الرئيسية
                </a>

                <div class="text-center mt-4">
                    <p class="text-muted small">
                        © 2026 نظام مَسَار للمدارس - بوابتك الآمنة للإدارة المدرسية الذكية
                    </p>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
