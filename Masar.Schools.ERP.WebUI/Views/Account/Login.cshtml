@model Masar.Schools.ERP.WebUI.Controllers.LoginViewModel
@{
    ViewData["Title"] = "مَسَار للمدارس - بوابة الدخول الموحدة";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link href="~/css/fonts.css" rel="stylesheet">
    <link href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" rel="stylesheet">
    <link href="~/lib/fontawesome/css/all.min.css" rel="stylesheet">
    <style>
        :root {
            --masar-primary: #1a5f7a;
            --masar-secondary: #159895;
            --masar-accent: #57c5b6;
            --masar-light: #f0f8ff;
            --masar-dark: #0d3b4c;
        }

        body {
            background: linear-gradient(135deg, var(--masar-primary) 0%, var(--masar-secondary) 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .login-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .login-card {
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            overflow: hidden;
            max-width: 900px;
            width: 100%;
        }

        .login-header {
            background: linear-gradient(135deg, var(--masar-primary) 0%, var(--masar-secondary) 100%);
            color: white;
            padding: 40px;
            text-align: center;
        }

        .masar-logo {
            font-size: 3rem;
            margin-bottom: 20px;
            color: white;
        }

        .masar-title {
            font-size: 2.5rem;
            font-weight: bold;
            margin-bottom: 10px;
        }

        .masar-subtitle {
            font-size: 1.2rem;
            opacity: 0.9;
        }

        .login-body {
            padding: 40px;
        }

        .form-floating > label {
            right: 0;
            left: auto;
        }

        .btn-masar {
            background: linear-gradient(135deg, var(--masar-primary) 0%, var(--masar-secondary) 100%);
            border: none;
            color: white;
            padding: 12px 30px;
            border-radius: 10px;
            font-weight: bold;
            transition: all 0.3s ease;
        }

        .btn-masar:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 20px rgba(21, 152, 149, 0.4);
            color: white;
        }

        .btn-masar:disabled {
            opacity: 0.7;
            cursor: not-allowed;
        }

        .password-toggle {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            color: #6c757d;
            z-index: 10;
        }

        .form-floating {
            position: relative;
        }

        .remember-me {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .forgot-password {
            color: var(--masar-secondary);
            text-decoration: none;
            transition: color 0.3s ease;
        }

        .forgot-password:hover {
            color: var(--masar-primary);
        }

        .features-section {
            background: var(--masar-light);
            padding: 30px;
            border-radius: 15px;
            margin-top: 30px;
        }

        .feature-item {
            display: flex;
            align-items: center;
            gap: 15px;
            margin-bottom: 15px;
        }

        .feature-icon {
            width: 50px;
            height: 50px;
            background: var(--masar-accent);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--masar-dark);
            font-size: 1.2rem;
        }

        .alert-masar {
            border-radius: 10px;
            border: none;
        }

        .spinner-border-sm {
            width: 1rem;
            height: 1rem;
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="login-card">
            <div class="login-header">
                <div class="masar-logo">
                    <i class="fas fa-graduation-cap"></i>
                </div>
                <h1 class="masar-title">مَسَار للمدارس</h1>
                <p class="masar-subtitle">بوابة الدخول الموحدة</p>
            </div>

            <div class="login-body">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger alert-masar mb-4">
                        <i class="fas fa-exclamation-circle me-2"></i>
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    </div>
                }

                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-masar mb-4">
                        <i class="fas fa-check-circle me-2"></i>
                        @TempData["SuccessMessage"]
                    </div>
                }

                <form method="post" id="loginForm">
                    @Html.AntiForgeryToken()
                    
                    <div class="mb-4">
                        <div class="form-floating">
                            <input type="text" class="form-control" id="username" 
                                   placeholder="اسم المستخدم أو البريد الإلكتروني" 
                                   asp-for="Username" required>
                            <label for="username">اسم المستخدم أو البريد الإلكتروني</label>
                            <i class="fas fa-user position-absolute" style="left: 15px; top: 50%; transform: translateY(-50%); color: #6c757d;"></i>
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="form-floating">
                            <input type="password" class="form-control" id="password" 
                                   placeholder="كلمة المرور" asp-for="Password" required>
                            <label for="password">كلمة المرور</label>
                            <i class="fas fa-eye password-toggle" id="togglePassword"></i>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="remember-me">
                            <input type="checkbox" id="rememberMe" asp-for="RememberMe">
                            <label for="rememberMe" class="mb-0">تذكرني</label>
                        </div>
                        <a href="/Auth/Register" class="forgot-password">
                            <i class="fas fa-user-plus me-1"></i>
                            إنشاء حساب جديد
                        </a>
                    </div>

                    <div class="text-center mb-4">
                        <a href="/Auth/ForgotPassword" class="forgot-password small">
                            <i class="fas fa-key me-1"></i>
                            نسيت كلمة المرور؟
                        </a>
                    </div>

                    <button type="submit" class="btn btn-masar w-100 btn-lg" id="loginButton">
                        <span id="loginButtonText">
                            <i class="fas fa-sign-in-alt me-2"></i>
                            تسجيل الدخول
                        </span>
                        <span id="loginSpinner" class="d-none">
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            جاري تسجيل الدخول...
                        </span>
                    </button>
                </form>

                <div class="features-section">
                    <h5 class="text-center mb-4" style="color: var(--masar-dark);">
                        <i class="fas fa-star me-2"></i>
                        مميزات نظام مَسَار
                    </h5>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="feature-item">
                                <div class="feature-icon">
                                    <i class="fas fa-comments"></i>
                                </div>
                                <div>
                                    <strong>تواصل فوري</strong>
                                    <p class="mb-0 text-muted small">دردشة مباشرة مع الواتساب</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="feature-item">
                                <div class="feature-icon">
                                    <i class="fas fa-fingerprint"></i>
                                </div>
                                <div>
                                    <strong>حضور آلي</strong>
                                    <p class="mb-0 text-muted small">بصمة ذكية وإشعارات فورية</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="feature-item">
                                <div class="feature-icon">
                                    <i class="fas fa-file-invoice"></i>
                                </div>
                                <div>
                                    <strong>فواتير إلكترونية</strong>
                                    <p class="mb-0 text-muted small">تكامل مع ZATCA</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="feature-item">
                                <div class="feature-icon">
                                    <i class="fas fa-university"></i>
                                </div>
                                <div>
                                    <strong>تكامل حكومي</strong>
                                    <p class="mb-0 text-muted small">مزامنة مع نظام نور</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="text-center mt-4">
                    <p class="text-muted">
                        <i class="fas fa-shield-alt me-1"></i>
                        نظام آمن ومحمي بأحدث تقنيات التشفير
                    </p>
                    <p class="text-muted small">
                        © 2026 نظام مَسَار للمدارس - بوابتك الآمنة للإدارة المدرسية الذكية
                    </p>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/sweetalert2/dist/sweetalert2.all.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Toggle password visibility
            const togglePassword = document.getElementById('togglePassword');
            const passwordInput = document.getElementById('password');

            togglePassword.addEventListener('click', function() {
                const type = passwordInput.getAttribute('type') === 'password' ? 'text' : 'password';
                passwordInput.setAttribute('type', type);
                this.classList.toggle('fa-eye');
                this.classList.toggle('fa-eye-slash');
            });

            // Form validation and loading state
            const loginForm = document.getElementById('loginForm');
            const loginButton = document.getElementById('loginButton');
            const loginButtonText = document.getElementById('loginButtonText');
            const loginSpinner = document.getElementById('loginSpinner');

            loginForm.addEventListener('submit', function(e) {
                const username = document.getElementById('username').value.trim();
                const password = document.getElementById('password').value;

                if (!username || !password) {
                    e.preventDefault();
                    Swal.fire({
                        icon: 'error',
                        title: 'بيانات ناقصة',
                        text: 'يرجى إدخال اسم المستخدم وكلمة المرور',
                        confirmButtonText: 'حسناً',
                        confirmButtonColor: '#1a5f7a'
                    });
                    return false;
                }

                // Show loading state
                loginButton.disabled = true;
                loginButtonText.classList.add('d-none');
                loginSpinner.classList.remove('d-none');
            });

            // Handle any error messages
            @if (!ViewData.ModelState.IsValid)
            {
                @:Swal.fire({
                @:    icon: 'error',
                @:    title: 'خطأ في تسجيل الدخول',
                @:    text: 'يرجى التحقق من بيانات الدخول والمحاولة مرة أخرى',
                @:    confirmButtonText: 'حسناً',
                @:    confirmButtonColor: '#1a5f7a'
                @:});
            }
        });
    </script>
</body>
</html>
