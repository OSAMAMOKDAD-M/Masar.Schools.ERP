@model Masar.Schools.ERP.WebUI.Controllers.ProfileViewModel

@{
    ViewData["Title"] = "الملف الشخصي";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-person-circle"></i> الملف الشخصي
                    </h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        <!-- Profile Image Section -->
                        <div class="col-md-4 text-center mb-4">
                            <div class="profile-image-container">
                                @if (!string.IsNullOrEmpty(Model.ProfileImagePath))
                                {
                                    <img src="@Model.ProfileImagePath" alt="صورة الملف الشخصي" 
                                         class="rounded-circle img-fluid profile-image" 
                                         style="width: 200px; height: 200px; object-fit: cover;">
                                }
                                else
                                {
                                    <div class="rounded-circle bg-secondary d-flex align-items-center justify-content-center profile-placeholder"
                                         style="width: 200px; height: 200px; margin: 0 auto;">
                                        <i class="bi bi-person-fill text-white" style="font-size: 80px;"></i>
                                    </div>
                                }
                            </div>
                            <h5 class="mt-3">@Model.FirstName @Model.LastName</h5>
                            <p class="text-muted">@Model.UserName</p>
                        </div>

                        <!-- Profile Information Form -->
                        <div class="col-md-8">
                            <form asp-action="Profile" method="post">
                                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="FirstName" class="form-label fw-bold"></label>
                                        <input asp-for="FirstName" class="form-control" />
                                        <span asp-validation-for="FirstName" class="text-danger"></span>
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label asp-for="LastName" class="form-label fw-bold"></label>
                                        <input asp-for="LastName" class="form-control" />
                                        <span asp-validation-for="LastName" class="text-danger"></span>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Email" class="form-label fw-bold"></label>
                                    <input asp-for="Email" class="form-control" readonly />
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                    <small class="text-muted">لا يمكن تغيير البريد الإلكتروني</small>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="UserName" class="form-label fw-bold"></label>
                                    <input asp-for="UserName" class="form-control" readonly />
                                    <span asp-validation-for="UserName" class="text-danger"></span>
                                    <small class="text-muted">لا يمكن تغيير اسم المستخدم</small>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="PhoneNumber" class="form-label fw-bold"></label>
                                    <input asp-for="PhoneNumber" class="form-control" />
                                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="NationalId" class="form-label fw-bold">الرقم الوطني</label>
                                    <input asp-for="NationalId" class="form-control" />
                                    <span asp-validation-for="NationalId" class="text-danger"></span>
                                </div>

                                <!-- Read-only Information -->
                                <div class="row mt-4">
                                    <div class="col-md-12">
                                        <div class="p-3 bg-light rounded">
                                            <small class="text-muted d-block">آخر تسجيل دخول</small>
                                            <strong>@(Model.LastLoginAt?.ToString("yyyy/MM/dd HH:mm") ?? "لم يسجل دخول بعد")</strong>
                                        </div>
                                    </div>
                                </div>

                                <div class="mt-4">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-save"></i> حفظ التغييرات
                                    </button>
                                    <a href="@Url.Action("Index", "Home")" class="btn btn-secondary">
                                        <i class="bi bi-arrow-left"></i> العودة
                                    </a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .profile-image-container {
            position: relative;
            display: inline-block;
        }

        .profile-image {
            border: 4px solid #0d6efd;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

        .profile-placeholder {
            border: 4px solid #6c757d;
            box-shadow: 0 4px 8px rgba(0,0,0,0.1);
        }

        .card-header {
            background: linear-gradient(135deg, #0d6efd 0%, #0056b3 100%);
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
