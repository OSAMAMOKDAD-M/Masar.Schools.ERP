@model Masar.Schools.ERP.Domain.DTOs.CreateAlumniRecordDto

@{
    ViewData["Title"] = "إضافة خريج";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">دليل الخريجين</a></li>
                    <li class="breadcrumb-item active">إضافة خريج</li>
                </ol>
            </nav>
            <h2 class="mb-3"><i class="bi bi-plus-circle"></i> إضافة خريج جديد</h2>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="All" class="text-danger"></div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="StudentId" class="form-label">الطالب</label>
                                <select asp-for="StudentId" class="form-control" required>
                                    <option value="">اختر الطالب</option>
                                    <!-- Student options should be populated from controller -->
                                </select>
                                <span asp-validation-for="StudentId" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="GraduationYear" class="form-label">سنة التخرج</label>
                                <input asp-for="GraduationYear" class="form-control" type="number" value="@ViewBag.GraduationYear" required />
                                <span asp-validation-for="GraduationYear" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="FinalGPA" class="form-label">المعدل النهائي</label>
                                <input asp-for="FinalGPA" class="form-control" type="number" step="0.01" />
                                <span asp-validation-for="FinalGPA" class="text-danger"></span>
                            </div>
                        </div>

                        <hr />
                        <h5>معلومات الجامعة</h5>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="University" class="form-label">الجامعة (إنجليزي)</label>
                                <input asp-for="University" class="form-control" />
                                <span asp-validation-for="University" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="UniversityArabic" class="form-label">الجامعة (عربي)</label>
                                <input asp-for="UniversityArabic" class="form-control" />
                                <span asp-validation-for="UniversityArabic" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Major" class="form-label">التخصص (إنجليزي)</label>
                                <input asp-for="Major" class="form-control" />
                                <span asp-validation-for="Major" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="MajorArabic" class="form-label">التخصص (عربي)</label>
                                <input asp-for="MajorArabic" class="form-control" />
                                <span asp-validation-for="MajorArabic" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="UniversityEnrollmentDate" class="form-label">تاريخ الالتحاق</label>
                                <input asp-for="UniversityEnrollmentDate" class="form-control" type="date" />
                                <span asp-validation-for="UniversityEnrollmentDate" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="UniversityGraduationDate" class="form-label">تاريخ التخرج الجامعي</label>
                                <input asp-for="UniversityGraduationDate" class="form-control" type="date" />
                                <span asp-validation-for="UniversityGraduationDate" class="text-danger"></span>
                            </div>
                        </div>

                        <hr />
                        <h5>معلومات التوظيف</h5>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="EmploymentStatus" class="form-label">حالة التوظيف</label>
                                <select asp-for="EmploymentStatus" class="form-control">
                                    <option value="">اختر الحالة</option>
                                    <option value="Employed">Employed - موظف</option>
                                    <option value="Unemployed">Unemployed - غير موظف</option>
                                    <option value="SelfEmployed">SelfEmployed - عمل حر</option>
                                    <option value="Student">Student - طالب</option>
                                </select>
                                <span asp-validation-for="EmploymentStatus" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="EmploymentStatusArabic" class="form-label">حالة التوظيف (عربي)</label>
                                <input asp-for="EmploymentStatusArabic" class="form-control" />
                                <span asp-validation-for="EmploymentStatusArabic" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="CompanyName" class="form-label">الشركة (إنجليزي)</label>
                                <input asp-for="CompanyName" class="form-control" />
                                <span asp-validation-for="CompanyName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CompanyNameArabic" class="form-label">الشركة (عربي)</label>
                                <input asp-for="CompanyNameArabic" class="form-control" />
                                <span asp-validation-for="CompanyNameArabic" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="JobTitle" class="form-label">المسمى الوظيفي (إنجليزي)</label>
                                <input asp-for="JobTitle" class="form-control" />
                                <span asp-validation-for="JobTitle" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="JobTitleArabic" class="form-label">المسمى الوظيفي (عربي)</label>
                                <input asp-for="JobTitleArabic" class="form-control" />
                                <span asp-validation-for="JobTitleArabic" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="EmploymentStartDate" class="form-label">تاريخ بدء العمل</label>
                                <input asp-for="EmploymentStartDate" class="form-control" type="date" />
                                <span asp-validation-for="EmploymentStartDate" class="text-danger"></span>
                            </div>
                        </div>

                        <hr />
                        <h5>معلومات الاتصال</h5>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="PersonalEmail" class="form-label">البريد الإلكتروني الشخصي</label>
                                <input asp-for="PersonalEmail" class="form-control" type="email" />
                                <span asp-validation-for="PersonalEmail" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PersonalPhone" class="form-label">رقم الهاتف</label>
                                <input asp-for="PersonalPhone" class="form-control" />
                                <span asp-validation-for="PersonalPhone" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="LinkedInProfile" class="form-label">LinkedIn</label>
                                <input asp-for="LinkedInProfile" class="form-control" type="url" />
                                <span asp-validation-for="LinkedInProfile" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Website" class="form-label">الموقع الإلكتروني</label>
                                <input asp-for="Website" class="form-control" type="url" />
                                <span asp-validation-for="Website" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="CurrentAddress" class="form-label">العنوان الحالي (إنجليزي)</label>
                                <input asp-for="CurrentAddress" class="form-control" />
                                <span asp-validation-for="CurrentAddress" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="CurrentAddressArabic" class="form-label">العنوان الحالي (عربي)</label>
                                <input asp-for="CurrentAddressArabic" class="form-control" />
                                <span asp-validation-for="CurrentAddressArabic" class="text-danger"></span>
                            </div>
                        </div>

                        <hr />
                        <h5>معلومات إضافية</h5>

                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label asp-for="Achievements" class="form-label">الإنجازات (إنجليزي)</label>
                                <textarea asp-for="Achievements" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Achievements" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label asp-for="AchievementsArabic" class="form-label">الإنجازات (عربي)</label>
                                <textarea asp-for="AchievementsArabic" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="AchievementsArabic" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label asp-for="Notes" class="form-label">ملاحظات (إنجليزي)</label>
                                <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Notes" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-12">
                                <label asp-for="NotesArabic" class="form-label">ملاحظات (عربي)</label>
                                <textarea asp-for="NotesArabic" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="NotesArabic" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-group">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> حفظ
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-x-circle"></i> إلغاء
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
