@model Masar.Schools.ERP.Domain.DTOs.CreateGraduationClearanceRecordDto

@{
    ViewData["Title"] = "إنشاء إبراء تخرج";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="mb-3"><i class="bi bi-plus-circle"></i> إنشاء إبراء تخرج</h2>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <form asp-action="CreateClearance" method="post">
                        <div asp-validation-summary="All" class="text-danger"></div>
                        <input type="hidden" asp-for="StudentId" value="@ViewBag.StudentId" />

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="GraduationYear" class="form-label">سنة التخرج</label>
                                <input asp-for="GraduationYear" class="form-control" type="number" value="@ViewBag.GraduationYear" required />
                                <span asp-validation-for="GraduationYear" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="GradeLevel" class="form-label">المرحلة</label>
                                <input asp-for="GradeLevel" class="form-control" />
                                <span asp-validation-for="GradeLevel" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="GradeLevelArabic" class="form-label">المرحلة (عربي)</label>
                                <input asp-for="GradeLevelArabic" class="form-control" />
                                <span asp-validation-for="GradeLevelArabic" class="text-danger"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ClearanceStatus" class="form-label">الحالة</label>
                                <select asp-for="ClearanceStatus" class="form-control">
                                    <option value="Pending">Pending - معلق</option>
                                    <option value="Cleared">Cleared - موافق</option>
                                    <option value="Rejected">Rejected - مرفوض</option>
                                </select>
                                <span asp-validation-for="ClearanceStatus" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-group">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-save"></i> حفظ
                            </button>
                            <a asp-action="Clearance" class="btn btn-secondary">
                                <i class="bi bi-x-circle"></i> إلغاء
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
