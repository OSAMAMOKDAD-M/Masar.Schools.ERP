@model Masar.Schools.ERP.Domain.DTOs.GraduationDocumentDto

@{
    ViewData["Title"] = "حذف الوثيقة";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="mb-3"><i class="bi bi-trash"></i> حذف وثيقة التخرج</h2>
        </div>
    </div>

    @if (Model != null)
    {
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="alert alert-warning">
                            <h4><i class="bi bi-exclamation-triangle"></i> تأكيد الحذف</h4>
                            <p>هل أنت متأكد من حذف الوثيقة التالية؟</p>
                        </div>

                        <dl class="row">
                            <dt class="col-sm-3">نوع الوثيقة:</dt>
                            <dd class="col-sm-9">@Model.DocumentTypeArabic</dd>

                            <dt class="col-sm-3">رقم الوثيقة:</dt>
                            <dd class="col-sm-9">@Model.DocumentNumber</dd>

                            <dt class="col-sm-3">تاريخ الإصدار:</dt>
                            <dd class="col-sm-9">@Model.IssueDate.ToString("yyyy-MM-dd")</dd>
                        </dl>

                        <form asp-action="DeleteDocumentConfirmed" method="post">
                            <input type="hidden" asp-for="Id" />
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash"></i> نعم، احذف
                            </button>
                            <a asp-action="Documents" asp-route-alumniRecordId="@Model.AlumniRecordId" class="btn btn-secondary">
                                <i class="bi bi-x-circle"></i> إلغاء
                            </a>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
