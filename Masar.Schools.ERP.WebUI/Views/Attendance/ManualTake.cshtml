@{
    ViewData["Title"] = "التحضير السريع";
}

<div class="row mb-4">
    <div class="col-12">
        <h1 class="h3 mb-3">
            <i class="bi bi-pencil-square"></i> التحضير السريع
        </h1>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-right"></i> العودة للحضور
        </a>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <label class="form-label">اختر الفصل</label>
                <select class="form-select" id="classSelect">
                    <option value="">اختر الفصل</option>
                    <option value="1">الفصل 1-أ</option>
                    <option value="2">الفصل 1-ب</option>
                    <option value="3">الفصل 2-أ</option>
                </select>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <label class="form-label">التاريخ</label>
                <input type="date" class="form-control" id="attendanceDate" value="@DateTime.Now.ToString("yyyy-MM-dd")">
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <label class="form-label">الفترة</label>
                <select class="form-select" id="periodSelect">
                    <option value="morning">الفترة الصباحية</option>
                    <option value="afternoon">الفترة المسائية</option>
                    <option value="full">اليوم الكامل</option>
                </select>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <div class="row align-items-center">
                    <div class="col">
                        <h5 class="mb-0">حضور الطلاب</h5>
                    </div>
                    <div class="col-auto">
                        <button class="btn btn-success" onclick="markAllPresent()">
                            <i class="bi bi-check-all"></i> الكل حاضر
                        </button>
                        <button class="btn btn-primary" onclick="saveAttendance()">
                            <i class="bi bi-save"></i> حفظ الحضور
                        </button>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>رقم الطالب</th>
                                <th>الاسم</th>
                                <th>الحالة</th>
                                <th>وقت الوصول</th>
                                <th>ملاحظات</th>
                            </tr>
                        </thead>
                        <tbody id="attendanceBody">
                            <tr>
                                <td>1</td>
                                <td>20260001</td>
                                <td>أحمد محمد أحمد</td>
                                <td>
                                    <select class="form-select form-select-sm status-select">
                                        <option value="present" selected>حاضر</option>
                                        <option value="absent">غائب</option>
                                        <option value="late">متأخر</option>
                                        <option value="excused">عذر</option>
                                    </select>
                                </td>
                                <td>
                                    <input type="time" class="form-control form-control-sm" value="07:30">
                                </td>
                                <td>
                                    <input type="text" class="form-control form-control-sm" placeholder="ملاحظات">
                                </td>
                            </tr>
                            <tr>
                                <td>2</td>
                                <td>20260002</td>
                                <td>محمد علي محمد</td>
                                <td>
                                    <select class="form-select form-select-sm status-select">
                                        <option value="present" selected>حاضر</option>
                                        <option value="absent">غائب</option>
                                        <option value="late">متأخر</option>
                                        <option value="excused">عذر</option>
                                    </select>
                                </td>
                                <td>
                                    <input type="time" class="form-control form-control-sm" value="07:45">
                                </td>
                                <td>
                                    <input type="text" class="form-control form-control-sm" placeholder="ملاحظات">
                                </td>
                            </tr>
                            <tr>
                                <td>3</td>
                                <td>20260003</td>
                                <td>سارة أحمد محمد</td>
                                <td>
                                    <select class="form-select form-select-sm status-select">
                                        <option value="present">حاضر</option>
                                        <option value="absent" selected>غائب</option>
                                        <option value="late">متأخر</option>
                                        <option value="excused">عذر</option>
                                    </select>
                                </td>
                                <td>
                                    <input type="time" class="form-control form-control-sm" disabled>
                                </td>
                                <td>
                                    <input type="text" class="form-control form-control-sm" placeholder="السبب">
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title">حاضر</h5>
                <h3 class="text-success" id="presentCount">2</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title">غائب</h5>
                <h3 class="text-danger" id="absentCount">1</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title">متأخر</h5>
                <h3 class="text-warning" id="lateCount">0</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title">عذر</h5>
                <h3 class="text-info" id="excusedCount">0</h3>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function markAllPresent() {
            document.querySelectorAll('.status-select').forEach(select => {
                select.value = 'present';
            });
            updateCounts();
        }
        
        function updateCounts() {
            let present = 0, absent = 0, late = 0, excused = 0;
            
            document.querySelectorAll('.status-select').forEach(select => {
                switch(select.value) {
                    case 'present': present++; break;
                    case 'absent': absent++; break;
                    case 'late': late++; break;
                    case 'excused': excused++; break;
                }
            });
            
            document.getElementById('presentCount').textContent = present;
            document.getElementById('absentCount').textContent = absent;
            document.getElementById('lateCount').textContent = late;
            document.getElementById('excusedCount').textContent = excused;
        }
        
        function saveAttendance() {
            // In real implementation, this would send data to the server
            alert('تم حفظ الحضور بنجاح!');
        }
        
        // Update counts when status changes
        document.querySelectorAll('.status-select').forEach(select => {
            select.addEventListener('change', updateCounts);
        });
    </script>
}
