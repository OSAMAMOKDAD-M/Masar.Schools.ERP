@model List<Masar.Schools.ERP.WebUI.ViewModels.ClassroomListVM>
@{
    ViewData["Title"] = "إدارة الفصول الدراسية";
}

<div class="row mb-4">
    <div class="col-12">
        <h1 class="h3 mb-3">
            <i class="bi bi-door-open"></i> إدارة الفصول الدراسية
        </h1>
        <p class="text-muted">إدارة وتنظيم الفصول الدراسية في النظام</p>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-primary text-white">
                <div class="d-flex justify-content-between align-items-center">
                    <h5 class="mb-0"><i class="bi bi-list-ul"></i> قائمة الفصول</h5>
                    <button class="btn btn-light btn-sm" data-bs-toggle="modal" data-bs-target="#createModal">
                        <i class="bi bi-plus-circle"></i> إضافة فصل جديد
                    </button>
                </div>
            </div>
            <div class="card-body">
                <!-- Form of Filters -->
                <div class="row mb-3">
                    <div class="col-md-3">
                        <label class="form-label">المدرسة</label>
                        <select id="filterSchool" class="form-select" asp-items="ViewBag.Schools">
                            <option value="">جميع المدارس</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">المرحلة</label>
                        <select id="filterGrade" class="form-select" asp-items="ViewBag.GradeLevels">
                            <option value="">جميع المراحل</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">البحث</label>
                        <input type="text" id="searchInput" class="form-control" placeholder="ابحث باسم الفصل أو الكود...">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">&nbsp;</label>
                        <button id="applyFilters" class="btn btn-primary w-100">
                            <i class="bi bi-funnel"></i> تطبيق الفلتر
                        </button>
                    </div>
                </div>

                <!-- Table -->
                <div class="table-responsive">
                    <table class="table table-hover table-striped" id="classroomsTable">
                        <thead class="table-dark">
                            <tr>
                                <th>الكود</th>
                                <th>اسم الفصل</th>
                                <th>المرحلة</th>
                                <th>الشعبة</th>
                                <th>السعة</th>
                                <th>المستخدم</th>
                                <th>المتاح</th>
                                <th>الحالة</th>
                                <th>المدرسة</th>
                                <th>المؤسسة</th>
                                <th>المعلم</th>
                                <th>الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td><span class="badge bg-secondary">@item.Code</span></td>
                                        <td>
                                            <strong>@item.NameArabic</strong>
                                            <br>
                                            <small class="text-muted">@item.Name</small>
                                        </td>
                                        <td>@(item.GradeLevelName ?? item.GradeLevel)</td>
                                        <td>@(item.SectionName ?? item.Section)</td>
                                        <td>
                                            <div class="progress" style="height: 20px;">
                                                <div class="progress-bar @(item.AvailableCapacity < 5 ? "bg-danger" : item.AvailableCapacity < 10 ? "bg-warning" : "bg-success")" 
                                                     role="progressbar" 
                                                     style="width: @((item.CurrentCount * 100) / item.Capacity)%">
                                                    @item.CurrentCount / @item.Capacity
                                                </div>
                                            </div>
                                            <small>@item.CurrentCount طالب من @item.Capacity</small>
                                        </td>
                                        <td>
                                            <span class="badge @(item.AvailableCapacity > 0 ? "bg-success" : "bg-danger")">
                                                @item.AvailableCapacity متاح
                                            </span>
                                        </td>
                                        <td>
                                            @if (item.IsActive)
                                            {
                                                <span class="badge bg-success">نشط</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">غير نشط</span>
                                            }
                                        </td>
                                        <td>@item.SchoolName</td>
                                        <td>@item.TenantName</td>
                                        <td>@item.ClassTeacherName</td>
                                        <td>
                                            <div class="btn-group">
                                                <button class="btn btn-sm btn-info" onclick="loadDetails('@item.Id')">
                                                    <i class="bi bi-eye"></i>
                                                </button>
                                                <button class="btn btn-sm btn-warning" onclick="loadEdit('@item.Id')">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <button class="btn btn-sm btn-danger" onclick="loadDelete('@item.Id')">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="12" class="text-center text-muted py-4">
                                        <i class="bi bi-inbox"></i> لا توجد فصول دراسية
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (ViewBag.TotalPages > 1)
                {
                    <nav aria-label="Page navigation">
                        <ul class="pagination justify-content-center">
                            @if (ViewBag.CurrentPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="#" onclick="loadPage(@(ViewBag.CurrentPage - 1))">السابق</a>
                                </li>
                            }

                            @for (int i = 1; i <= ViewBag.TotalPages; i++)
                            {
                                <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                    <a class="page-link" href="#" onclick="loadPage(@i)">@i</a>
                                </li>
                            }

                            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                            {
                                <li class="page-item">
                                    <a class="page-link" href="#" onclick="loadPage(@(ViewBag.CurrentPage + 1))">التالي</a>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            </div>
        </div>
    </div>
</div>

<!-- Create Modal -->
<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="bi bi-plus-circle"></i> إضافة فصل جديد</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="createModalBody">
                <!-- يُحمّل المحتوى عبر AJAX -->
            </div>
        </div>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title"><i class="bi bi-pencil"></i> تعديل بيانات الفصل</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="editModalBody">
                <!-- يُحمّل المحتوى عبر AJAX -->
            </div>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="bi bi-exclamation-triangle"></i> تأكيد الحذف</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="deleteModalBody">
                <!-- يُحمّل المحتوى عبر AJAX -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // إدارة الفلترة
            document.getElementById('applyFilters').addEventListener('click', function() {
                loadPage(1);
            });

            // إضافة فصل جديد
            const createModal = document.getElementById('createModal');
            if (createModal) {
                createModal.addEventListener('show.bs.modal', function(e) {
                    loadCreateForm();
                });
            }

            // معالجة إرسال النماذج عبر AJAX
            document.addEventListener('submit', function(e) {
                const form = e.target.closest('form[data-ajax="true"]');
                if (form) {
                    e.preventDefault();
                    handleFormSubmit(form);
                }
            });

            // معالجة الحذف
            document.addEventListener('click', function(e) {
                if (e.target && e.target.id === 'confirmDelete') {
                    const form = e.target.closest('form');
                    if (form) {
                        handleDelete(form);
                    }
                }
            });
        });

        // تحميل الصفحة
        function loadPage(page) {
            const schoolId = document.getElementById('filterSchool').value;
            const gradeLevelId = document.getElementById('filterGrade').value;
            const searchTerm = document.getElementById('searchInput').value;

            window.location.href = '@Url.Action("Index")?page=' + page + 
                '&schoolId=' + (schoolId || '') + 
                '&gradeLevelId=' + (gradeLevelId || '') + 
                '&searchTerm=' + (searchTerm || '');
        }

        // إضافة فصل جديد
        async function loadCreateForm() {
            try {
                const response = await fetch('@Url.Action("Create")');
                const data = await response.text();
                document.getElementById('createModalBody').innerHTML = data;
                
                // تأخير بسيط للتأكد من تحميل العناصر قبل توليد الكود
                setTimeout(function() {
                    if (typeof generateAutoCode === 'function') {
                        generateAutoCode();
                    }
                }, 100);
            } catch (error) {
                console.error('Error loading create form:', error);
                showNotification('error', 'حدث خطأ أثناء تحميل نموذج الإضافة');
            }
        }

        // تعديل فصل
        async function loadEdit(id) {
            try {
                const response = await fetch('@Url.Action("Edit")/' + id);
                const data = await response.text();
                document.getElementById('editModalBody').innerHTML = data;
                const modal = new bootstrap.Modal(document.getElementById('editModal'));
                modal.show();
            } catch (error) {
                console.error('Error loading edit form:', error);
                showNotification('error', 'حدث خطأ أثناء تحميل نموذج التعديل');
            }
        }

        // حذف فصل
        async function loadDelete(id) {
            try {
                const response = await fetch('@Url.Action("Delete")/' + id);
                const data = await response.text();
                document.getElementById('deleteModalBody').innerHTML = data;
                const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
                modal.show();
            } catch (error) {
                console.error('Error loading delete confirmation:', error);
                showNotification('error', 'حدث خطأ أثناء تحميل تأكيد الحذف');
            }
        }

        // تفاصيل فصل
        function loadDetails(id) {
            window.location.href = '@Url.Action("Details")/' + id;
        }

        // معالجة إرسال النماذج عبر AJAX
        async function handleFormSubmit(form) {
            const url = form.action;
            const modalId = form.closest('.modal')?.id;
            const formData = new FormData(form);
            
            // الحصول على الـ token
            const tokenInput = form.querySelector('input[name="__RequestVerificationToken"]');
            const token = tokenInput ? tokenInput.value : null;

            console.log('Form action:', url);
            console.log('Token found:', !!token);
            console.log('Form data entries:');
            for (let [key, value] of formData.entries()) {
                console.log(key, value);
            }

            if (!token) {
                console.error('AntiForgery token not found');
                showNotification('error', 'رمز الأمان غير موجود، يرجى تحديث الصفحة');
                return;
            }

            try {
                const response = await fetch(url, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token,
                        'Accept': 'application/json'
                    },
                    body: formData
                });

                // قراءة النص أولاً
                const text = await response.text();
                console.log('Response status:', response.status);
                console.log('Response text:', text);

                // التعامل مع حالة الخطأ 400
                if (response.status === 400) {
                    console.error('Validation error response:', text);
                    throw new Error('خطأ في التحقق من البيانات: ' + text.substring(0, 200));
                }

                // التحقق من أن الرد ليس فارغاً
                if (!text || text.trim() === '') {
                    throw new Error('الرد فارغ من السيرفر');
                }

                // محاولة تحليل النص كـ JSON
                let result;
                try {
                    result = JSON.parse(text);
                } catch (e) {
                    console.error('JSON parse error:', e);
                    throw new Error('فشل تحليل الرد: ' + text.substring(0, 100));
                }

                if (result.success) {
                    // إغلاق المودال
                    if (modalId) {
                        const modalElement = document.getElementById(modalId);
                        const modalInstance = bootstrap.Modal.getInstance(modalElement);
                        if (modalInstance) {
                            modalInstance.hide();
                        }
                    }
                    
                    // إعادة تحميل الجدول
                    loadPage(@ViewBag.CurrentPage);
                    
                    // عرض رسالة نجاح
                    showNotification('success', result.message);
                } else {
                    showNotification('error', result.message || 'حدث خطأ أثناء معالجة الطلب');
                    if (result.errors && result.errors.length > 0) {
                        // عرض الأخطاء في النموذج
                        let errorHtml = '<div class="alert alert-danger"><ul>';
                        result.errors.forEach(function(error) {
                            errorHtml += '<li>' + error + '</li>';
                        });
                        errorHtml += '</ul></div>';
                        form.insertAdjacentHTML('afterbegin', errorHtml);
                    }
                }
            } catch (error) {
                console.error('Error submitting form:', error);
                showNotification('error', 'حدث خطأ أثناء معالجة الطلب: ' + error.message);
            }
        }

        // معالجة الحذف
        async function handleDelete(form) {
            const url = form.action;
            const formData = new FormData(form);
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            try {
                const response = await fetch(url, {
                    method: 'POST',
                    headers: {
                        'RequestVerificationToken': token
                    },
                    body: formData
                });

                const result = await response.json();

                if (result.success) {
                    const modalElement = document.getElementById('deleteModal');
                    const modalInstance = bootstrap.Modal.getInstance(modalElement);
                    if (modalInstance) {
                        modalInstance.hide();
                    }
                    loadPage(@ViewBag.CurrentPage);
                    showNotification('success', result.message);
                } else {
                    showNotification('error', result.message);
                }
            } catch (error) {
                console.error('Error deleting classroom:', error);
                showNotification('error', 'حدث خطأ أثناء حذف الفصل');
            }
        }

        // عرض الإشعارات
        function showNotification(type, message) {
            const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
            const alertHtml = '<div class="alert ' + alertClass + ' alert-dismissible fade show" role="alert">' +
                           '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>' +
                           '<strong>' + (type === 'success' ? 'نجاح' : 'خطأ') + ':</strong> ' + message +
                           '</div>';
            
            // إضافة الإشعار إلى أعلى الصفحة
            const cardBody = document.querySelector('.card-body');
            if (cardBody) {
                cardBody.insertAdjacentHTML('afterbegin', alertHtml);
            }
            
            // إخفاء الإشعار بعد 3 ثواني
            setTimeout(function() {
                const alerts = document.querySelectorAll('.alert');
                alerts.forEach(function(alert) {
                    const bsAlert = new bootstrap.Alert(alert);
                    bsAlert.close();
                });
            }, 3000);
        }
    </script>
}