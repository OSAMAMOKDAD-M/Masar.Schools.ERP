@model Masar.Schools.ERP.Domain.Entities.ClassRoom

<div class="alert alert-warning">
    <h5><i class="bi bi-exclamation-triangle"></i> تأكيد الحذف</h5>
    <p>هل أنت متأكد من حذف الفصل التالي؟</p>
    <hr>
    <div class="row">
        <div class="col-md-6">
            <strong>اسم الفصل:</strong> @Model.NameArabic
        </div>
        <div class="col-md-6">
            <strong>الكود:</strong> @Model.Code
        </div>
    </div>
    <div class="row mt-2">
        <div class="col-md-6">
            <strong>المرحلة:</strong> @Model.GradeLevelLegacy
        </div>
        <div class="col-md-6">
            <strong>الشعبة:</strong> @Model.SectionLegacy
        </div>
    </div>
    <div class="row mt-2">
        <div class="col-md-6">
            <strong>المدرسة:</strong> @Model.School?.NameArabic
        </div>
        <div class="col-md-6">
            <strong>عدد الطلاب:</strong> @Model.CurrentCount
        </div>
    </div>
</div>

<form method="post" action="@Url.Action("DeleteConfirmed", new { id = Model.Id })">
    @Html.AntiForgeryToken()
    <div class="d-flex gap-2 justify-content-end mt-3">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            <i class="bi bi-x-circle"></i> إلغاء
        </button>
        <button type="submit" id="confirmDelete" class="btn btn-danger">
            <i class="bi bi-trash"></i> نعم، احذف
        </button>
    </div>
</form>