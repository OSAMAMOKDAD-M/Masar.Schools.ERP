@model NewConversationDto
@{
    ViewData["Title"] = "محادثة جديدة";
}

<div class="row mb-4">
    <div class="col-12">
        <h1 class="h3 mb-3">
            <i class="bi bi-chat-dots"></i> محادثة جديدة
        </h1>
        <p class="text-muted">بدء محادثة جديدة مع ولي أمر</p>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <form asp-action="NewConversation" method="post">
                    @Html.AntiForgeryToken()
                    
                    <div class="mb-3">
                        <label asp-for="GuardianId" class="form-label">ولي الأمر</label>
                        <select asp-for="GuardianId" class="form-select" asp-items="ViewBag.Guardians" required>
                            <option value="">اختر ولي الأمر...</option>
                        </select>
                        <span asp-validation-for="GuardianId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="InitialMessage" class="form-label">الرسالة الأولية</label>
                        <textarea asp-for="InitialMessage" class="form-control" rows="5" required></textarea>
                        <span asp-validation-for="InitialMessage" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-send"></i> إرسال
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> عودة
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}