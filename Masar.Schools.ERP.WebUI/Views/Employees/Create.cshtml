@model EmployeeCreateDto
@{
    ViewData["Title"] = "إضافة موظف جديد";
}

<div class="row mb-4">
    <div class="col-12">
        <h1 class="h3 mb-3">
            <i class="bi bi-person-plus"></i> إضافة موظف جديد
        </h1>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-right"></i> العودة للقائمة
        </a>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <form asp-action="Create" method="post">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="FirstNameArabic" class="form-label">الاسم الأول (عربي)</label>
                            <input asp-for="FirstNameArabic" class="form-control" required>
                            <span asp-validation-for="FirstNameArabic" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LastNameArabic" class="form-label">اسم العائلة (عربي)</label>
                            <input asp-for="LastNameArabic" class="form-control" required>
                            <span asp-validation-for="LastNameArabic" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="FirstName" class="form-label">الاسم الأول (إنجليزي)</label>
                            <input asp-for="FirstName" class="form-control" required>
                            <span asp-validation-for="FirstName" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LastName" class="form-label">اسم العائلة (إنجليزي)</label>
                            <input asp-for="LastName" class="form-control" required>
                            <span asp-validation-for="LastName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label asp-for="NationalId" class="form-label">رقم الهوية الوطنية</label>
                            <input asp-for="NationalId" class="form-control">
                            <span asp-validation-for="NationalId" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="PhoneNumber" class="form-label">رقم الهاتف</label>
                            <input asp-for="PhoneNumber" class="form-control" required>
                            <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Email" class="form-label">البريد الإلكتروني</label>
                            <input asp-for="Email" type="email" class="form-control">
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="JobTitle" class="form-label">المسمى الوظيفي (إنجليزي)</label>
                            <input asp-for="JobTitle" class="form-control" required>
                            <span asp-validation-for="JobTitle" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="JobTitleArabic" class="form-label">المسمى الوظيفي (عربي)</label>
                            <input asp-for="JobTitleArabic" class="form-control" required>
                            <span asp-validation-for="JobTitleArabic" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="Department" class="form-label">القسم (إنجليزي)</label>
                            <input asp-for="Department" class="form-control">
                            <span asp-validation-for="Department" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DepartmentArabic" class="form-label">القسم (عربي)</label>
                            <input asp-for="DepartmentArabic" class="form-control">
                            <span asp-validation-for="DepartmentArabic" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label asp-for="HireDate" class="form-label">تاريخ التعيين</label>
                            <input asp-for="HireDate" type="date" class="form-control" required>
                            <span asp-validation-for="HireDate" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Salary" class="form-label">الراتب</label>
                            <input asp-for="Salary" type="number" step="0.01" class="form-control">
                            <span asp-validation-for="Salary" class="text-danger"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="SchoolId" class="form-label">المدرسة</label>
                            <select asp-for="SchoolId" class="form-select" asp-items="ViewBag.Schools">
                                <option value="">اختر المدرسة</option>
                            </select>
                            <span asp-validation-for="SchoolId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="BranchId" class="form-label">الفرع</label>
                            <select asp-for="BranchId" class="form-select" asp-items="ViewBag.Branches">
                                <option value="">اختر الفرع</option>
                            </select>
                            <span asp-validation-for="BranchId" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="BankName" class="form-label">اسم البنك</label>
                            <input asp-for="BankName" class="form-control">
                            <span asp-validation-for="BankName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label asp-for="BankAccountNumber" class="form-label">رقم الحساب البنكي</label>
                            <input asp-for="BankAccountNumber" class="form-control">
                            <span asp-validation-for="BankAccountNumber" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="ProfileImagePath" class="form-label">صورة الملف الشخصي</label>
                            <input asp-for="ProfileImagePath" class="form-control">
                            <span asp-validation-for="ProfileImagePath" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-12">
                            <label asp-for="Address" class="form-label">العنوان</label>
                            <textarea asp-for="Address" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle"></i> حفظ الموظف
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-x-circle"></i> إلغاء
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
