@model Masar.Schools.ERP.Domain.DTOs.LeaveRequestCreateDto
@{
    ViewData["Title"] = "طلب إجازة جديد";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">طلب إجازة جديد</h3>
                    <div class="card-tools">
                        <a href="@Url.Action("Leaves", "Employees")" class="btn btn-secondary">
                            <i class="fas fa-arrow-right"></i> العودة
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <form asp-action="CreateLeave" method="post">
                        @Html.AntiForgeryToken()
                        
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>الموظف <span class="text-danger">*</span></label>
                                    <select asp-for="EmployeeId" class="form-control" required>
                                        <option value="">اختر الموظف</option>
                                        @if (ViewBag.Employees != null)
                                        {
                                            @foreach (var employee in ViewBag.Employees)
                                            {
                                                <option value="@employee.Id">@employee.FullNameArabic</option>
                                            }
                                        }
                                    </select>
                                    <span asp-validation-for="EmployeeId" class="text-danger"></span>
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>نوع الإجازة <span class="text-danger">*</span></label>
                                    <select asp-for="LeaveType" class="form-control" required>
                                        <option value="">اختر نوع الإجازة</option>
                                        <option value="Annual">إجازة سنوية</option>
                                        <option value="Sick">إجازة مرضية</option>
                                        <option value="Maternity">إجازة أمومة</option>
                                        <option value="Emergency">إجازة طارئة</option>
                                        <option value="Unpaid">إجازة بدون راتب</option>
                                        <option value="Study">إجازة دراسية</option>
                                        <option value="Marriage">إجازة زواج</option>
                                        <option value="Bereavement">إجازة عزاء</option>
                                    </select>
                                    <span asp-validation-for="LeaveType" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>نوع الإجازة بالعربية <span class="text-danger">*</span></label>
                                    <input asp-for="LeaveTypeArabic" class="form-control" required placeholder="مثال: إجازة سنوية" />
                                    <span asp-validation-for="LeaveTypeArabic" class="text-danger"></span>
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>تاريخ البدء <span class="text-danger">*</span></label>
                                    <input asp-for="StartDate" type="date" class="form-control" required />
                                    <span asp-validation-for="StartDate" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>تاريخ الانتهاء <span class="text-danger">*</span></label>
                                    <input asp-for="EndDate" type="date" class="form-control" required />
                                    <span asp-validation-for="EndDate" class="text-danger"></span>
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label>إجازة مدفوعة</label>
                                    <div class="form-check mt-2">
                                        <input asp-for="IsPaid" class="form-check-input" />
                                        <label class="form-check-label">نعم، هذه إجازة مدفوعة</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>السبب</label>
                            <textarea asp-for="Reason" class="form-control" rows="3" placeholder="اكتب سبب الإجازة..."></textarea>
                            <span asp-validation-for="Reason" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label>السبب بالعربية</label>
                            <textarea asp-for="ReasonArabic" class="form-control" rows="3" placeholder="اكتب سبب الإجازة بالعربية..."></textarea>
                            <span asp-validation-for="ReasonArabic" class="text-danger"></span>
                        </div>

                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i>
                            سيتم حساب عدد الأيام تلقائياً بناءً على تاريخ البدء والانتهاء.
                        </div>

                        <div class="form-group">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-paper-plane"></i> إرسال الطلب
                            </button>
                            <a href="@Url.Action("Leaves", "Employees")" class="btn btn-secondary">
                                <i class="fas fa-times"></i> إلغاء
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Auto-update LeaveTypeArabic when LeaveType changes
        document.getElementById('LeaveType').addEventListener('change', function() {
            var arabicNames = {
                'Annual': 'إجازة سنوية',
                'Sick': 'إجازة مرضية',
                'Maternity': 'إجازة أمومة',
                'Emergency': 'إجازة طارئة',
                'Unpaid': 'إجازة بدون راتب',
                'Study': 'إجازة دراسية',
                'Marriage': 'إجازة زواج',
                'Bereavement': 'إجازة عزاء'
            };
            document.getElementById('LeaveTypeArabic').value = arabicNames[this.value] || '';
        });
    </script>
}