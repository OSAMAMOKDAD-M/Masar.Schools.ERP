@model List<Employee>
@{
    ViewData["Title"] = "الموظفون";
}

<div class="row mb-4">
    <div class="col-12">
        <h1 class="h3 mb-3">
            <i class="bi bi-person-workspace"></i> إدارة الموظفين
        </h1>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-person-plus"></i> إضافة موظف جديد
        </a>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>الاسم</th>
                                <th>رقم الموظف</th>
                                <th>المسمى الوظيفي</th>
                                <th>القسم</th>
                                <th>المدرسة</th>
                                <th>الراتب</th>
                                <th>الحالة</th>
                                <th>الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var employee in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@employee.FullNameArabic</strong><br>
                                        <small class="text-muted">@employee.FullName</small>
                                    </td>
                                    <td>@employee.EmployeeNumber</td>
                                    <td>@employee.JobTitleArabic</td>
                                    <td>@employee.DepartmentArabic</td>
                                    <td>@employee.School?.NameArabic</td>
                                    <td>@employee.Salary?.ToString("N0")</td>
                                    <td>
                                        @if (employee.IsActive)
                                        {
                                            <span class="status-badge success">نشط</span>
                                        }
                                        else
                                        {
                                            <span class="status-badge danger">غير نشط</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-action="TeacherSchedule" asp-route-id="@employee.Id" class="btn btn-sm btn-info">
                                            <i class="bi bi-calendar-week"></i>
                                        </a>
                                        <a asp-action="Payroll" class="btn btn-sm btn-success">
                                            <i class="bi bi-cash-coin"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
