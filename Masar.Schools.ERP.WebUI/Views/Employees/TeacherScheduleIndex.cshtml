@model IEnumerable<Employee>
@{
    ViewData["Title"] = "جدول المعلمين";
}

<div class="row mb-4">
    <div class="col-12">
        <h1 class="h3 mb-3">
            <i class="bi bi-calendar-week"></i> جدول المعلمين
        </h1>
        <div class="btn-group">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-right"></i> قائمة الموظفين
            </a>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus"></i> إضافة معلم
            </a>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">قائمة المعلمين</h5>
            </div>
            <div class="card-body">
                @if (Model != null && Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>رقم الموظف</th>
                                    <th>الاسم</th>
                                    <th>المسمى الوظيفي</th>
                                    <th>القسم</th>
                                    <th>المدرسة</th>
                                    <th>الفرع</th>
                                    <th>الحالة</th>
                                    <th>الإجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var teacher in Model)
                                {
                                    <tr>
                                        <td>@teacher.EmployeeNumber</td>
                                        <td>
                                            <strong>@teacher.FullNameArabic</strong>
                                            <br>
                                            <small class="text-muted">@teacher.FullName</small>
                                        </td>
                                        <td>@teacher.JobTitleArabic</td>
                                        <td>@teacher.DepartmentArabic</td>
                                        <td>@teacher.School?.NameArabic</td>
                                        <td>@teacher.Branch?.NameArabic</td>
                                        <td>
                                            @if (teacher.IsActive)
                                            {
                                                <span class="badge bg-success">نشط</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">غير نشط</span>
                                            }
                                        </td>
                                        <td>
                                            <a asp-action="TeacherSchedule" asp-route-id="@teacher.Id" class="btn btn-sm btn-info">
                                                <i class="bi bi-calendar-week"></i> جدول
                                            </a>
                                            <a asp-action="Details" asp-route-id="@teacher.Id" class="btn btn-sm btn-primary">
                                                <i class="bi bi-eye"></i> تفاصيل
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i>
                        لا يوجد معلمين مسجلين في النظام حالياً.
                        <br>
                        <a asp-action="Create" class="btn btn-primary mt-2">
                            <i class="bi bi-plus"></i> إضافة معلم جديد
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">إحصائيات سريعة</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3">
                        <div class="text-center">
                            <h3 class="text-primary">@(Model?.Count() ?? 0)</h3>
                            <p class="text-muted">إجمالي المعلمين</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-center">
                            <h3 class="text-success">@(Model?.Count(e => e.IsActive) ?? 0)</h3>
                            <p class="text-muted">المعلمون النشطون</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-center">
                            <h3 class="text-warning">@(Model?.Count(e => !e.IsActive) ?? 0)</h3>
                            <p class="text-muted">المعلمون غير النشطين</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="text-center">
                            <h3 class="text-info">@(Model?.Select(e => e.DepartmentArabic).Distinct().Count() ?? 0)</h3>
                            <p class="text-muted">الأقسام المختلفة</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
