@model List<Masar.Schools.ERP.Domain.Entities.AuditLog>

@{
    ViewData["Title"] = "سجل المراجعة";
    var periodName = ViewBag.PeriodName as string;
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h5 class="mb-0">
                        <i class="bi bi-journal-text"></i> سجل المراجعة - @periodName
                    </h5>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-right"></i> رجوع
                    </a>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>التاريخ والوقت</th>
                                    <th>المستخدم</th>
                                    <th>نوع العملية</th>
                                    <th>الكيان</th>
                                    <th>الوصف</th>
                                    <th>السبب</th>
                                    <th>عنوان IP</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    @foreach (var log in Model)
                                    {
                                        <tr>
                                            <td>@log.ActionDate.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                            <td>@log.UserName</td>
                                            <td>
                                                <span class="badge bg-@(log.ActionType == "Override" ? "warning" : "primary")">
                                                    @log.ActionType
                                                </span>
                                            </td>
                                            <td>@log.EntityName</td>
                                            <td>@log.Description</td>
                                            <td>@(log.Reason ?? "-")</td>
                                            <td>@(log.IpAddress ?? "-")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7" class="text-center">لا توجد سجلات مراجعة</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
