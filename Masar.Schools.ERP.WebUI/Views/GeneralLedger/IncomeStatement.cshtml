@model Masar.Schools.ERP.WebUI.Controllers.IncomeStatementViewModel
@using Masar.Schools.ERP.Domain.Entities
@{
    ViewData["Title"] = "قائمة الدخل";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">دفتر الأستاذ العام</a></li>
                    <li class="breadcrumb-item active" aria-current="page">قائمة الدخل</li>
                </ol>
            </nav>
            
            <h2 class="text-end mb-3">قائمة الدخل</h2>
            
            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <form method="get" class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label">من تاريخ</label>
                            <input type="date" name="fromDate" class="form-control" value="@ViewBag.FromDate?.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">إلى تاريخ</label>
                            <input type="date" name="toDate" class="form-control" value="@ViewBag.ToDate?.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary w-100">عرض قائمة الدخل</button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="card shadow-sm mb-3">
                        <div class="card-header bg-success text-white">
                            <h5 class="mb-0">الإيرادات</h5>
                        </div>
                        <div class="card-body">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>رقم الحساب</th>
                                        <th>اسم الحساب</th>
                                        <th class="text-end">المبلغ</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var revenue in Model.Revenues)
                                    {
                                        <tr>
                                            <td>@revenue.Account.AccountCode</td>
                                            <td>@revenue.Account.AccountNameAr</td>
                                            <td class="text-end">@revenue.Balance.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-light fw-bold">
                                    <tr>
                                        <td colspan="2" class="text-end">إجمالي الإيرادات:</td>
                                        <td class="text-end">@ViewBag.TotalRevenue?.ToString("N2")</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="card shadow-sm mb-3">
                        <div class="card-header bg-danger text-white">
                            <h5 class="mb-0">المصروفات</h5>
                        </div>
                        <div class="card-body">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>رقم الحساب</th>
                                        <th>اسم الحساب</th>
                                        <th class="text-end">المبلغ</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var expense in Model.Expenses)
                                    {
                                        <tr>
                                            <td>@expense.Account.AccountCode</td>
                                            <td>@expense.Account.AccountNameAr</td>
                                            <td class="text-end">@expense.Balance.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-light fw-bold">
                                    <tr>
                                        <td colspan="2" class="text-end">إجمالي المصروفات:</td>
                                        <td class="text-end">@ViewBag.TotalExpenses?.ToString("N2")</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-12 text-center">
                            <h4>صافي الدخل: @ViewBag.NetIncome?.ToString("N2") ر.س</h4>
                            @if (ViewBag.NetIncome >= 0)
                            {
                                <span class="badge bg-success fs-5">ربح</span>
                            }
                            else
                            {
                                <span class="badge bg-danger fs-5">خسارة</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>