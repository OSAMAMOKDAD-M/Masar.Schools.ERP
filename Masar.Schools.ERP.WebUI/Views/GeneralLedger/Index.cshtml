@model IEnumerable<Masar.Schools.ERP.Domain.Entities.JournalEntry>
@using Masar.Schools.ERP.Domain.Entities
@{
    ViewData["Title"] = "دفتر الأستاذ العام";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <h2 class="text-end mb-3">دفتر الأستاذ العام</h2>
            
            <div class="card shadow-sm">
                <div class="card-body">
                    <form method="get" class="row g-3">
                        <div class="col-md-3">
                            <label class="form-label">من تاريخ</label>
                            <input type="date" name="fromDate" class="form-control" value="@ViewBag.FromDate?.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">إلى تاريخ</label>
                            <input type="date" name="toDate" class="form-control" value="@ViewBag.ToDate?.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">الحساب</label>
                            <select name="accountId" class="form-select">
                                <option value="">جميع الحسابات</option>
                                @if (ViewBag.Accounts != null)
                                {
                                    var accounts = ViewBag.Accounts as System.Collections.Generic.IEnumerable<Masar.Schools.ERP.Domain.Entities.Account>;
                                    if (accounts != null)
                                    {
                                        @foreach (var account in accounts)
                                        {
                                            <option value="@account.Id" selected="@(ViewBag.SelectedAccountId != null && ViewBag.SelectedAccountId.ToString() == account.Id.ToString())">
                                                @account.AccountCode - @account.AccountNameAr
                                            </option>
                                        }
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <button type="submit" class="btn btn-primary w-100">بحث</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">إجمالي المدين</h5>
                    <h3 class="text-success">@ViewBag.TotalDebit?.ToString("N2") ر.س</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">إجمالي الدائن</h5>
                    <h3 class="text-danger">@ViewBag.TotalCredit?.ToString("N2") ر.س</h3>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <h5 class="card-title">الفرق</h5>
                    <h3 class="text-primary">@((ViewBag.TotalDebit - ViewBag.TotalCredit)?.ToString("N2")) ر.س</h3>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <div class="card shadow-sm">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>رقم القيد</th>
                                    <th>التاريخ</th>
                                    <th>الوصف</th>
                                    <th>النوع</th>
                                    <th>المدين</th>
                                    <th>الدائن</th>
                                    <th>المرجع</th>
                                    <th>الإجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var entry in Model)
                                {
                                    <tr>
                                        <td>@entry.EntryNumber</td>
                                        <td>@entry.EntryDate.ToString("yyyy-MM-dd")</td>
                                        <td>@entry.Description</td>
                                        <td>
                                            @switch (entry.EntryType)
                                            {
                                                case EntryType.Invoice: <span class="badge bg-primary">فاتورة</span>; break;
                                                case EntryType.Payment: <span class="badge bg-success">سداد</span>; break;
                                                case EntryType.Discount: <span class="badge bg-warning">خصم</span>; break;
                                                default: <span class="badge bg-secondary">@entry.EntryType</span>; break;
                                            }
                                        </td>
                                        <td class="text-success">@entry.TotalDebit.ToString("N2")</td>
                                        <td class="text-danger">@entry.TotalCredit.ToString("N2")</td>
                                        <td>@entry.ReferenceType - @entry.ReferenceId</td>
                                        <td>
                                            <a asp-action="JournalEntry" asp-route-id="@entry.Id" class="btn btn-sm btn-info">
                                                <i class="fas fa-eye"></i> عرض
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>