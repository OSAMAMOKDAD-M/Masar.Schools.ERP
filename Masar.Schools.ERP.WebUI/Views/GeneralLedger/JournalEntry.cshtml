@model Masar.Schools.ERP.Domain.Entities.JournalEntry
@using Masar.Schools.ERP.Domain.Entities
@{
    ViewData["Title"] = "تفاصيل القيد المحاسبي";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">دفتر الأستاذ العام</a></li>
                    <li class="breadcrumb-item active" aria-current="page">تفاصيل القيد</li>
                </ol>
            </nav>
            
            <h2 class="text-end mb-3">تفاصيل القيد المحاسبي</h2>
            
            <div class="card shadow-sm mb-3">
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h5>معلومات القيد</h5>
                            <table class="table table-sm">
                                <tr>
                                    <th>رقم القيد:</th>
                                    <td>@Model.EntryNumber</td>
                                </tr>
                                <tr>
                                    <th>التاريخ:</th>
                                    <td>@Model.EntryDate.ToString("yyyy-MM-dd HH:mm")</td>
                                </tr>
                                <tr>
                                    <th>الوصف:</th>
                                    <td>@Model.Description</td>
                                </tr>
                                <tr>
                                    <th>النوع:</th>
                                    <td>
                                        @switch (Model.EntryType)
                                        {
                                            case EntryType.Invoice: <span class="badge bg-primary">فاتورة</span>; break;
                                            case EntryType.Payment: <span class="badge bg-success">سداد</span>; break;
                                            case EntryType.Discount: <span class="badge bg-warning">خصم</span>; break;
                                            default: <span class="badge bg-secondary">@Model.EntryType</span>; break;
                                        }
                                    </td>
                                </tr>
                                <tr>
                                    <th>المرجع:</th>
                                    <td>@Model.ReferenceType - @Model.ReferenceId</td>
                                </tr>
                                <tr>
                                    <th>الحالة:</th>
                                    <td>
                                        @if (Model.IsPosted)
                                        {
                                            <span class="badge bg-success">مرحل</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning">غير مرحل</span>
                                        }
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div class="col-md-6">
                            <h5>الإجماليات</h5>
                            <table class="table table-sm">
                                <tr>
                                    <th>إجمالي المدين:</th>
                                    <td class="text-success">@Model.TotalDebit.ToString("N2") ر.س</td>
                                </tr>
                                <tr>
                                    <th>إجمالي الدائن:</th>
                                    <td class="text-danger">@Model.TotalCredit.ToString("N2") ر.س</td>
                                </tr>
                                <tr>
                                    <th>المعتمد:</th>
                                    <td>@Model.PostedBy</td>
                                </tr>
                                <tr>
                                    <th>تاريخ الترحيل:</th>
                                    <td>@Model.PostedDate?.ToString("yyyy-MM-dd HH:mm")</td>
                                </tr>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card shadow-sm">
                <div class="card-header bg-dark text-white">
                    <h5 class="mb-0">سطور القيد المحاسبي</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>رقم السطر</th>
                                    <th>رقم الحساب</th>
                                    <th>اسم الحساب</th>
                                    <th>الوصف</th>
                                    <th>الطالب</th>
                                    <th class="text-end">مدين</th>
                                    <th class="text-end">دائن</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var line in Model.EntryLines.OrderBy(l => l.LineNumber))
                                {
                                    <tr>
                                        <td>@line.LineNumber</td>
                                        <td>@line.Account.AccountCode</td>
                                        <td>@line.Account.AccountNameAr</td>
                                        <td>@line.Description</td>
                                        <td>@line.Student?.FullNameArabic ?? "-"</td>
                                        <td class="text-end">@line.Debit.ToString("N2")</td>
                                        <td class="text-end">@line.Credit.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light fw-bold">
                                <tr>
                                    <td colspan="5" class="text-end">الإجمالي:</td>
                                    <td class="text-end">@Model.TotalDebit.ToString("N2")</td>
                                    <td class="text-end">@Model.TotalCredit.ToString("N2")</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            <div class="mt-3">
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-right"></i> العودة لدفتر الأستاذ العام
                </a>
            </div>
        </div>
    </div>
</div>