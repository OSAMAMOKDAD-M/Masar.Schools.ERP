@{
    ViewData["Title"] = "الشهادات";
}

<div class="row mb-4">
    <div class="col-12">
        <h1 class="h3 mb-3">
            <i class="bi bi-award"></i> شهادات الطلاب
        </h1>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-right"></i> العودة للدرجات
        </a>
        <button class="btn btn-primary" onclick="generateCertificates()">
            <i class="bi bi-printer"></i> إنشاء الشهادات
        </button>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <label class="form-label">اختر الفصل</label>
                <select class="form-select" id="classSelect">
                    <option value="">اختر الفصل</option>
                    <option value="1" selected>الفصل 1-أ</option>
                    <option value="2">الفصل 1-ب</option>
                    <option value="3">الفصل 2-أ</option>
                </select>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <label class="form-label">نوع الشهادة</label>
                <select class="form-select" id="certificateType">
                    <option value="academic">الإنجاز الأكاديمي</option>
                    <option value="attendance">الحضور الكامل</option>
                    <option value="behavior">السلوك الممتاز</option>
                    <option value="completion">إكمال الدورة</option>
                </select>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <label class="form-label">Academic Year</label>
                <select class="form-select" id="academicYear">
                    <option value="2025-2026" selected>2025-2026</option>
                    <option value="2024-2025">2024-2025</option>
                </select>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">الطلاب المؤهلون للحصول على الشهادات</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th><input type="checkbox" id="selectAll" onchange="toggleAll()"></th>
                                <th>رقم الطالب</th>
                                <th>الاسم</th>
                                <th>الدرجة التراكمية</th>
                                <th>نسبة الحضور</th>
                                <th>نوع الشهادة</th>
                                <th>الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody id="studentsBody">
                            <tr>
                                <td><input type="checkbox" class="student-checkbox" checked></td>
                                <td>20260001</td>
                                <td>أحمد محمد أحمد</td>
                                <td class="text-success fw-bold">95%</td>
                                <td class="text-success fw-bold">98%</td>
                                <td>الإنجاز الأكاديمي</td>
                                <td>
                                    <button class="btn btn-sm btn-info" onclick="previewCertificate(1)">
                                        <i class="bi bi-eye"></i> معاينة
                                    </button>
                                    <button class="btn btn-sm btn-success" onclick="printCertificate(1)">
                                        <i class="bi bi-printer"></i> طباعة
                                    </button>
                                </td>
                            </tr>
                            <tr>
                                <td><input type="checkbox" class="student-checkbox" checked></td>
                                <td>20260002</td>
                                <td>محمد علي محمد</td>
                                <td class="text-primary fw-bold">88%</td>
                                <td class="text-success fw-bold">100%</td>
                                <td>الحضور الكامل</td>
                                <td>
                                    <button class="btn btn-sm btn-info" onclick="previewCertificate(2)">
                                        <i class="bi bi-eye"></i> معاينة
                                    </button>
                                    <button class="btn btn-sm btn-success" onclick="printCertificate(2)">
                                        <i class="bi bi-printer"></i> طباعة
                                    </button>
                                </td>
                            </tr>
                            <tr>
                                <td><input type="checkbox" class="student-checkbox" checked></td>
                                <td>20260003</td>
                                <td>سارة أحمد محمد</td>
                                <td class="text-success fw-bold">97%</td>
                                <td class="text-success fw-bold">99%</td>
                                <td>الإنجاز الأكاديمي</td>
                                <td>
                                    <button class="btn btn-sm btn-info" onclick="previewCertificate(3)">
                                        <i class="bi bi-eye"></i> معاينة
                                    </button>
                                    <button class="btn btn-sm btn-success" onclick="printCertificate(3)">
                                        <i class="bi bi-printer"></i> طباعة
                                    </button>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Certificate Preview Modal -->
<div class="modal fade" id="certificateModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">معاينة الشهادة</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="certificate-preview" id="certificatePreview">
                    <div class="certificate-border">
                        <div class="certificate-header">
                            <h2>نظام مَسَار للمدارس</h2>
                            <h3>Masar For Schools System</h3>
                        </div>
                        <div class="certificate-body">
                            <h4>شهادة إنجاز أكاديمي</h4>
                            <h4>Academic Achievement Certificate</h4>
                            <p class="certificate-text">
                                تمنح هذه الشهادة للطالب/ة
                            </p>
                            <h3 class="student-name">أحمد محمد أحمد</h3>
                            <p class="certificate-text">
                                لتحقيقه/ها التميز الأكاديمي للعام الدراسي 2025-2026
                            </p>
                            <div class="certificate-grade">
                                <h2>الدرجة: A+</h2>
                                <p>التراكمي: 95%</p>
                            </div>
                        </div>
                        <div class="certificate-footer">
                            <div class="signature">
                                <p>توقيع المدير</p>
                                <div class="signature-line"></div>
                            </div>
                            <div class="date">
                                <p>التاريخ: @DateTime.Now.ToString("dd/MM/yyyy")</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إغلاق</button>
                <button type="button" class="btn btn-primary" onclick="printCertificate()">
                    <i class="bi bi-printer"></i> طباعة الشهادة
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .certificate-preview {
        border: 4px solid #007bff;
        padding: 40px;
        background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
        text-align: center;
    }
    
    .certificate-border {
        border: 2px solid #000;
        padding: 30px;
        background: white;
    }
    
    .certificate-header h2 {
        color: #007bff;
        font-weight: bold;
        margin-bottom: 5px;
    }
    
    .certificate-header h3 {
        color: #6c757d;
        font-size: 1.2rem;
        margin-bottom: 30px;
    }
    
    .certificate-body h4 {
        color: #000;
        margin: 20px 0;
    }
    
    .certificate-text {
        font-size: 1.1rem;
        margin: 15px 0;
        color: #495057;
    }
    
    .student-name {
        color: #007bff;
        font-size: 2rem;
        margin: 30px 0;
        font-weight: bold;
    }
    
    .certificate-grade h2 {
        color: #28a745;
        margin: 20px 0;
    }
    
    .certificate-footer {
        display: flex;
        justify-content: space-between;
        margin-top: 40px;
        padding-top: 20px;
        border-top: 1px solid #dee2e6;
    }
    
    .signature-line {
        width: 200px;
        height: 3px;
        background-color: #000;
        margin-top: 10px;
    }
    
    @@media print {
        .no-print {
            display: none;
        }
        .certificate-preview {
            border: none;
            padding: 0;
        }
    }
</style>

@section Scripts {
    <script>
        function toggleAll() {
            const selectAll = document.getElementById('selectAll');
            document.querySelectorAll('.student-checkbox').forEach(checkbox => {
                checkbox.checked = selectAll.checked;
            });
        }
        
        function previewCertificate(studentId) {
            // In real implementation, this would load the specific student's certificate
            const modal = new bootstrap.Modal(document.getElementById('certificateModal'));
            modal.show();
        }
        
        function printCertificate(studentId) {
            window.print();
        }
        
        function generateCertificates() {
            const selected = document.querySelectorAll('.student-checkbox:checked').length;
            if (selected > 0) {
                alert(`جاري إنشاء ${selected} شهادة...`);
            } else {
                alert('الرجاء اختيار طالب واحد على الأقل.');
            }
        }
    </script>
}
