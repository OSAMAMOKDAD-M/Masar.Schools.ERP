@model List<ClassRoom>
@{
    ViewData["Title"] = "الدرجات والامتحانات";
}

<div class="row mb-4">
    <div class="col-12">
        <h1 class="h3 mb-3">
            <i class="bi bi-journal-bookmark"></i> الدرجات والامتحانات
        </h1>
        <p class="text-muted">إدارة الدرجات والكنترول والامتحانات</p>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>الفصل</th>
                                <th>المرحلة</th>
                                <th>السعة</th>
                                <th>العدد الحالي</th>
                                <th>الفرع</th>
                                <th>الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var classRoom in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@classRoom.NameArabic</strong><br>
                                        <small class="text-muted">@classRoom.Name</small>
                                    </td>
                                    <td>@classRoom.GradeLevelLegacy</td>
                                    <td>@classRoom.Capacity</td>
                                    <td>@classRoom.CurrentCount</td>
                                    <td>@classRoom.Branch?.NameArabic</td>
                                    <td>
                                        <a asp-action="ControlSheet" asp-route-classId="@classRoom.Id" asp-route-termId="@ViewBag.CurrentTerm" class="btn btn-sm btn-primary">
                                            <i class="bi bi-table"></i> الكنترول
                                        </a>
                                        <a asp-action="GenerateSeatingNumbers" asp-route-classId="@classRoom.Id" class="btn btn-sm btn-info">
                                            <i class="bi bi-list-ol"></i> أرقام الجلوس
                                        </a>
                                        <a asp-action="Certificates" asp-route-classId="@classRoom.Id" class="btn btn-sm btn-success">
                                            <i class="bi bi-award"></i> الشهادات
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
