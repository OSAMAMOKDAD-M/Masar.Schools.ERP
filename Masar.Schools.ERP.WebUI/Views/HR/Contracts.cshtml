@model List<Masar.Schools.ERP.Domain.Entities.HR.Contract>
@{
    ViewData["Title"] = "إدارة العقود";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="text-primary">
                <i class="bi bi-file-earmark-text"></i> إدارة العقود
            </h2>
            <p class="text-muted">إدارة عقود الموظفين وتجديدها وأرشفتها</p>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-12">
            <a asp-action="CreateContract" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> إنشاء عقد جديد
            </a>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>رقم العقد</th>
                            <th>الموظف</th>
                            <th>المسمى الوظيفي</th>
                            <th>تاريخ البدء</th>
                            <th>تاريخ الانتهاء</th>
                            <th>الراتب</th>
                            <th>المدة</th>
                            <th>الحالة</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var contract in Model)
                        {
                            <tr>
                                <td>@contract.ContractNumber</td>
                                <td>@contract.Employee?.FullNameArabic</td>
                                <td>@contract.JobTitleArabic</td>
                                <td>@contract.StartDate.ToString("yyyy-MM-dd")</td>
                                <td>@contract.EndDate.ToString("yyyy-MM-dd")</td>
                                <td>@contract.Salary.ToString("N0") ريال</td>
                                <td>
                                    @if (contract.DurationYears > 0)
                                    {
                                        @($"{contract.DurationYears} سنة")
                                    }
                                    @if (contract.DurationMonths > 0)
                                    {
                                        @($"{contract.DurationMonths} شهر")
                                    }
                                    @if (contract.DurationDays > 0)
                                    {
                                        @($"{contract.DurationDays} يوم")
                                    }
                                </td>
                                <td>
                                    @if (contract.IsCurrent)
                                    {
                                        <span class="badge bg-success">ساري</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">منتهي</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@contract.Id" class="btn btn-sm btn-info">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@contract.Id" class="btn btn-sm btn-warning">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    @if (contract.IsCurrent)
                                    {
                                        <a asp-action="Renew" asp-route-id="@contract.Id" class="btn btn-sm btn-success">
                                            <i class="bi bi-arrow-clockwise"></i>
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>