@model List<Masar.Schools.ERP.Domain.Entities.HR.ResignedEmployee>
@{
    ViewData["Title"] = "مكافأة نهاية الخدمة";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <h2 class="text-primary">
                <i class="bi bi-gift"></i> مكافأة نهاية الخدمة
            </h2>
            <p class="text-muted">حساب وإدارة مكافآت نهاية الخدمة للموظفين المستقيلين</p>
        </div>
    </div>

    <div class="row mb-3">
        <div class="col-12">
            <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#resignEmployeeModal">
                <i class="bi bi-person-x"></i> تسجيل استقالة موظف
            </button>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>الموظف</th>
                            <th>القسم</th>
                            <th>تاريخ الاستقالة</th>
                            <th>مدة الخدمة</th>
                            <th>الراتب</th>
                            <th>مكافأة نهاية الخدمة</th>
                            <th>السبب</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var resigned in Model)
                        {
                            <tr>
                                <td>@resigned.FullNameArabic</td>
                                <td>@resigned.DepartmentArabic</td>
                                <td>@resigned.ResignDate.ToString("yyyy-MM-dd")</td>
                                <td>
                                    @if (resigned.ServiceYears > 0)
                                    {
                                        @($"{resigned.ServiceYears} سنة")
                                    }
                                    @if (resigned.ServiceMonths > 0)
                                    {
                                        @($"{resigned.ServiceMonths} شهر")
                                    }
                                    @if (resigned.ServiceDays > 0)
                                    {
                                        @($"{resigned.ServiceDays} يوم")
                                    }
                                </td>
                                <td>@resigned.Salary.ToString("N0") ريال</td>
                                <td class="fw-bold text-success">@resigned.GratuityAmount.ToString("N0") ريال</td>
                                <td>@resigned.ReasonArabic</td>
                                <td>
                                    <button class="btn btn-sm btn-info" onclick="showCalculation('@resigned.EmployeeId')">
                                        <i class="bi bi-calculator"></i>
                                    </button>
                                    <button class="btn btn-sm btn-success" onclick="generateLetter('@resigned.EmployeeId', 'ExperienceCertificate')">
                                        <i class="bi bi-file-earmark-text"></i>
                                    </button>
                                    <button class="btn btn-sm btn-primary" onclick="generateLetter('@resigned.EmployeeId', 'GratuityCalculation')">
                                        <i class="bi bi-cash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Resign Employee Modal -->
<div class="modal fade" id="resignEmployeeModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">تسجيل استقالة موظف</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="resignForm">
                    <div class="mb-3">
                        <label class="form-label">الموظف</label>
                        <select class="form-select" id="employeeId" name="employeeId" required>
                            <option value="">اختر الموظف</option>
                            <!-- Will be populated dynamically -->
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">تاريخ الاستقالة</label>
                        <input type="date" class="form-control" id="resignDate" name="resignDate" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">سبب الاستقالة</label>
                        <textarea class="form-control" id="reason" name="reason" rows="3"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">ملاحظات</label>
                        <textarea class="form-control" id="notes" name="notes" rows="2"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="button" class="btn btn-primary" onclick="submitResignation()">تسجيل</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Load employees on modal show
        document.getElementById('resignEmployeeModal').addEventListener('show.bs.modal', function() {
            fetch('/HR/GetActiveEmployees')
                .then(response => response.json())
                .then(data => {
                    const select = document.getElementById('employeeId');
                    select.innerHTML = '<option value="">اختر الموظف</option>';
                    data.forEach(emp => {
                        select.innerHTML += `<option value="${emp.id}">${emp.nameArabic}</option>`;
                    });
                });
        });

        function submitResignation() {
            const form = document.getElementById('resignForm');
            const formData = new FormData(form);
            
            fetch('/HR/CreateResignedEmployee', {
                method: 'POST',
                body: formData
            }).then(() => {
                bootstrap.Modal.getInstance(document.getElementById('resignEmployeeModal')).hide();
                location.reload();
            });
        }

        function showCalculation(employeeId) {
            fetch(`/HR/CalculateGratuity/${employeeId}`)
                .then(response => response.json())
                .then(data => {
                    alert(`تفاصيل الحساب:\n${data.calculationDetails}\n\nالمبلغ الإجمالي: ${data.gratuityAmount} ريال`);
                });
        }

        function generateLetter(employeeId, letterType) {
            window.location.href = `/HR/GenerateGratuityLetter?employeeId=${employeeId}&type=${letterType}`;
        }
    </script>
}