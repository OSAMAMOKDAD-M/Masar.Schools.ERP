@model List<Masar.Schools.ERP.Domain.DTOs.InventoryItemDto>

@{
    ViewData["Title"] = "الأصناف";
    Layout = "_Layout";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">قائمة الأصناف</h3>
                    <a asp-action="CreateItem" class="btn btn-primary">
                        <i class="fas fa-plus"></i> إضافة صنف جديد
                    </a>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th>الكود (SKU)</th>
                                    <th>الاسم</th>
                                    <th>الاسم بالعربية</th>
                                    <th>التصنيف</th>
                                    <th>وحدة القياس</th>
                                    <th>الرصيد الحالي</th>
                                    <th>الحد الأدنى</th>
                                    <th>الحد الأقصى</th>
                                    <th>السعر</th>
                                    <th>الحالة</th>
                                    <th>الإجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@item.SKU</td>
                                        <td>@item.Name</td>
                                        <td>@item.NameArabic</td>
                                        <td>@item.Category</td>
                                        <td>@item.UnitOfMeasure</td>
                                        <td>@item.CurrentStock</td>
                                        <td>@item.ReorderLevel</td>
                                        <td>@item.MaxStockLevel</td>
                                        <td>@item.SellingPrice @item.Currency</td>
                                        <td>
                                            @if (item.IsActive)
                                            {
                                                <span class="badge badge-success">نشط</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-danger">غير نشط</span>
                                            }
                                        </td>
                                        <td>
                                            <a asp-action="EditItem" asp-route-id="@item.Id" class="btn btn-sm btn-info">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <form asp-action="DeleteItem" asp-route-id="@item.Id" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('هل أنت متأكد من حذف هذا الصنف؟')">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
