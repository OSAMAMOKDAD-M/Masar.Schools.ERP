@model List<Masar.Schools.ERP.Domain.DTOs.InventoryItemDto>

@{
    ViewData["Title"] = "تقرير المخزون الزائد";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">تقرير المخزون الزائد</h3>
                </div>
                <div class="card-body">
                    <table class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>الصنف</th>
                                <th>الكود</th>
                                <th>الحد الأقصى</th>
                                <th>الحالة</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var item in Model.Where(i => i.MaxStockLevel > 0))
                                {
                                    <tr>
                                        <td>@item.NameArabic</td>
                                        <td>@item.SKU</td>
                                        <td>@item.MaxStockLevel</td>
                                        <td>
                                            <span class="badge bg-warning">تحتاج مراجعة</span>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center">لا توجد أصناف زائدة</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
