@model List<Masar.Schools.ERP.Domain.DTOs.WarehouseDto>

@{
    ViewData["Title"] = "المخازن";
    Layout = "_Layout";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">قائمة المخازن</h3>
                    <a asp-action="CreateWarehouse" class="btn btn-primary">
                        <i class="fas fa-plus"></i> إضافة مخزن جديد
                    </a>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th>الكود</th>
                                    <th>الاسم</th>
                                    <th>الاسم بالعربية</th>
                                    <th>النوع</th>
                                    <th>المدرسة</th>
                                    <th>المدير</th>
                                    <th>السعة</th>
                                    <th>الحالة</th>
                                    <th>الإجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var warehouse in Model)
                                {
                                    <tr>
                                        <td>@warehouse.Code</td>
                                        <td>@warehouse.Name</td>
                                        <td>@warehouse.NameArabic</td>
                                        <td>@warehouse.WarehouseType</td>
                                        <td>@warehouse.SchoolName</td>
                                        <td>@warehouse.Manager</td>
                                        <td>@(warehouse.Capacity?.ToString() + " " + warehouse.CapacityUnit)</td>
                                        <td>
                                            @if (warehouse.IsActive)
                                            {
                                                <span class="badge badge-success">نشط</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-danger">غير نشط</span>
                                            }
                                        </td>
                                        <td>
                                            <a asp-action="EditWarehouse" asp-route-id="@warehouse.Id" class="btn btn-sm btn-info">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <form asp-action="DeleteWarehouse" asp-route-id="@warehouse.Id" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('هل أنت متأكد من حذف هذا المخزن؟')">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
