@model RecordPaymentDto
@{
    ViewData["Title"] = "تسجيل دفعة";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <h2 class="text-end mb-3">تسجيل دفعة</h2>
            @if (ViewBag.StudentAccount != null)
            {
                var studentAccount = ViewBag.StudentAccount as Masar.Schools.ERP.Domain.Entities.StudentAccount;
                <div class="alert alert-info">
                    <strong>الطالب:</strong> @studentAccount.Student.FullNameArabic<br>
                    <strong>رقم الحساب:</strong> @studentAccount.AccountNumber<br>
                    <strong>الرصيد المستحق:</strong> @ViewBag.OutstandingBalance ر.س
                </div>
            }
            <a asp-action="StudentStatement" asp-route-id="@ViewBag.StudentAccount?.StudentId" class="btn btn-secondary">
                <i class="fas fa-arrow-right"></i> العودة لكشف الحساب
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0">بيانات الدفعة</h5>
                </div>
                <div class="card-body">
                    <form asp-action="RecordPayment" method="post">
                        <input type="hidden" asp-for="StudentAccountId" value="@Model.StudentAccountId" />

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">المبلغ</label>
                                <input type="number" asp-for="Amount" class="form-control" required step="0.01" min="0.01">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">طريقة الدفع</label>
                                <select asp-for="PaymentMethod" class="form-select" required>
                                    <option value="Cash">نقداً</option>
                                    <option value="BankTransfer">تحويل بنكي</option>
                                    <option value="Mada">مدى</option>
                                    <option value="Sadad">سداد</option>
                                    <option value="ApplePay">آبل باي</option>
                                    <option value="CreditCard">بطاقة ائتمان</option>
                                    <option value="Cheque">شيك</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">رقم المرجع</label>
                            <input type="text" asp-for="ReferenceNumber" class="form-control" placeholder="رقم العملية أو رقم الشيك">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">اسم البنك</label>
                            <input type="text" asp-for="BankName" class="form-control" placeholder="اختياري">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">ملاحظات</label>
                            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> تسجيل الدفعة
                            </button>
                            <a asp-action="StudentStatement" asp-route-id="@ViewBag.StudentAccount?.StudentId" class="btn btn-secondary">
                                <i class="fas fa-times"></i> إلغاء
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0">معلومات مهمة</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i>
                        <strong>ملاحظات مهمة:</strong>
                        <ul class="mb-0 mt-2">
                            <li>سيتم تخصيص الدفعة تلقائياً للفواتير القديمة (FIFO)</li>
                            <li>يمكنك تحديد فاتورة محددة للتخصيص</li>
                            <li>سيتم إنشاء قيد محاسبي تلقائي للدفعة</li>
                        </ul>
                    </div>

                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle"></i>
                        <strong>تنبيه:</strong>
                        <p class="mb-0 mt-2">
                            تأكد من إدخال المبلغ الصحيح قبل التسجيل.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
