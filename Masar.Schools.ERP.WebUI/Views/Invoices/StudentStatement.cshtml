@{
    ViewData["Title"] = "كشف الطالب";
}

<div class="row mb-4">
    <div class="col-12">
        <h1 class="h3 mb-3">
            <i class="bi bi-file-text"></i> كشف الطالب
        </h1>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-right"></i> العودة للفواتير
        </a>
        @if (Model.StudentAccount != null && Model.StudentAccount.OutstandingBalance > 0)
        {
            <a asp-action="RecordPayment" asp-route-studentAccountId="@Model.StudentAccount.AccountId" class="btn btn-primary">
                <i class="bi bi-cash"></i> تسجيل دفعة
            </a>
        }
        <button class="btn btn-primary" onclick="printStatement()">
            <i class="bi bi-printer"></i> طباعة الكشف
        </button>
        <button class="btn btn-success" onclick="exportPdf()">
            <i class="bi bi-file-earmark-pdf"></i> تصدير PDF
        </button>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <label class="form-label">الطالب</label>
                <select class="form-select" id="studentSelect">
                    <option value="1" selected>أحمد محمد أحمد (20260001)</option>
                    <option value="2">محمد علي محمد (20260002)</option>
                    <option value="3">سارة أحمد محمد (20260003)</option>
                </select>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <label class="form-label">من تاريخ</label>
                <input type="date" class="form-control" id="fromDate" value="2026-01-01">
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <label class="form-label">إلى تاريخ</label>
                <input type="date" class="form-control" id="toDate" value="@DateTime.Now.ToString("yyyy-MM-dd")">
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">معلومات الطالب</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3">
                        <p><strong>رقم الطالب:</strong> 20260001</p>
                        <p><strong>الاسم:</strong> أحمد محمد أحمد</p>
                    </div>
                    <div class="col-md-3">
                        <p><strong>الفصل:</strong> الفصل 1-أ</p>
                        <p><strong>المدرسة:</strong> مَسَار للمدارس</p>
                    </div>
                    <div class="col-md-3">
                        <p><strong>ولي الأمر:</strong> محمد أحمد</p>
                        <p><strong>الهاتف:</strong> 0501234567</p>
                    </div>
                    <div class="col-md-3">
                        <p><strong>فترة الكشف:</strong></p>
                        <p>2026-01-01 إلى 2026-01-27</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title">إجمالي الفواتير</h5>
                <h3 class="text-primary">45,000.00 ر.س</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <h5 class="card-title">إجمالي المدفوع</h5>
                <h3 class="text-success">30,000.00 ر.س</h3>
