<div class="row mt-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">سجل إرسال ZATCA</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>التاريخ/الوقت</th>
                                <th>الإجراء</th>
                                <th>الحالة</th>
                                <th>الرد</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>2026-01-15 10:30:00</td>
                                <td>إبلاغ</td>
                                <td><span class="status-badge success">نجح</span></td>
                                <td>تم الإبلاغ عن الفاتورة بنجاح</td>
                            </tr>
                            <tr>
                                <td>2026-01-15 10:30:05</td>
                                <td>تحقق</td>
                                <td><span class="status-badge success">نجح</span></td>
                                <td>تم التحقق من الفاتورة بنجاح</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .qr-code-display {
        text-align: center;
        padding: 20px;
        background-color: #f8f9fa;
        border-radius: 8px;
    }
    
    .xml-preview {
        max-height: 400px;
        overflow-y: auto;
    }
    
    .xml-preview pre {
        margin: 0;
        font-size: 12px;
    }
</style>

@section Scripts {
    <script>
        function downloadXml() {
            const xmlContent = document.querySelector('#xmlPreview code').textContent;
            const blob = new Blob([xmlContent], { type: 'application/xml' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'INV-2026-0001.xml';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        }
        
        function viewXml() {
            const preview = document.getElementById('xmlPreview');
            preview.style.display = preview.style.display === 'none' ? 'block' : 'none';
        }
        
        function resubmitZatca() {
            if (confirm('هل أنت متأكد من أنك تريد إعادة إرسال هذه الفاتورة إلى ZATCA؟')) {
                alert('تم إعادة إرسال الفاتورة إلى ZATCA بنجاح!');
            }
        }
    </script>
}
