@model Masar.Schools.ERP.WebUI.Controllers.LicenseGenerateViewModel
@{
    ViewData["Title"] = "إصدار ترخيص جديد";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-shield-plus"></i> إصدار ترخيص جديد</h5>
                </div>
                <div class="card-body">
                    <form asp-action="Generate" method="post">
                        @Html.AntiForgeryToken()
                        
                        <div class="mb-3">
                            <label asp-for="ClientName" class="form-label">اسم المدرسة/العميل</label>
                            <input asp-for="ClientName" class="form-control" required />
                            <span asp-validation-for="ClientName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="MachineId" class="form-label">كود الجهاز (Machine ID)</label>
                            <input asp-for="MachineId" class="form-control font-monospace" required />
                            <small class="text-muted">يجب أن يكون الكود المقدم من العميل</small>
                            <span asp-validation-for="MachineId" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="ValidFrom" class="form-label">تاريخ البدء</label>
                                <input asp-for="ValidFrom" type="date" class="form-control" required />
                                <span asp-validation-for="ValidFrom" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="ValidUntil" class="form-label">تاريخ الانتهاء</label>
                                <input asp-for="ValidUntil" type="date" class="form-control" required />
                                <span asp-validation-for="ValidUntil" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="MaxStudents" class="form-label">الحد الأقصى للطلاب</label>
                                <input asp-for="MaxStudents" type="number" class="form-control" min="1" required />
                                <span asp-validation-for="MaxStudents" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="MaxUsers" class="form-label">الحد الأقصى للمستخدمين</label>
                                <input asp-for="MaxUsers" type="number" class="form-control" min="1" required />
                                <span asp-validation-for="MaxUsers" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="LicenseType" class="form-label">نوع الترخيص</label>
                            <select asp-for="LicenseType" class="form-select" required>
                                <option value="@LicenseType.Trial">نسخة تجريبية</option>
                                <option value="@LicenseType.Standard" selected>نسخة قياسية</option>
                                <option value="@LicenseType.Professional">نسخة احترافية</option>
                                <option value="@LicenseType.Enterprise">نسخة مؤسسية</option>
                                <option value="@LicenseType.Custom">نسخة مخصصة</option>
                            </select>
                            <span asp-validation-for="LicenseType" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">الموديولات المفعلة</label>
                            <div class="row">
                                @foreach (var module in Model.AvailableModules.Where(m => m != LicenseModules.None && m != LicenseModules.FullEdition))
                                {
                                    <div class="col-md-6 mb-2">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" 
                                                   name="SelectedModules" 
                                                   value="@module" 
                                                   id="module_@module"
                                                   @(module == LicenseModules.Core ? "checked disabled" : "")>
                                            <label class="form-check-label" for="module_@module">
                                                @GetModuleDisplayName(module)
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Notes" class="form-label">ملاحظات</label>
                            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Notes" class="text-danger"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-shield-check"></i> إصدار الترخيص
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-right"></i> إلغاء
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    private string GetModuleDisplayName(Masar.Schools.ERP.Licensing.Models.LicenseModules module)
    {
        return module switch
        {
            Masar.Schools.ERP.Licensing.Models.LicenseModules.Core => "الوحدات الأساسية (إلزامي)",
            Masar.Schools.ERP.Licensing.Models.LicenseModules.ZATCA => "نظام ZATCA للفواتير",
            Masar.Schools.ERP.Licensing.Models.LicenseModules.WhatsApp => "تكامل واتساب",
            Masar.Schools.ERP.Licensing.Models.LicenseModules.Transport => "نظام النقل والمواصلات",
            Masar.Schools.ERP.Licensing.Models.LicenseModules.Clinic => "العيادة المدرسية",
            Masar.Schools.ERP.Licensing.Models.LicenseModules.Canteen => "المقصف المدرسي",
            Masar.Schools.ERP.Licensing.Models.LicenseModules.Timetable => "الجدول المدرسي",
            Masar.Schools.ERP.Licensing.Models.LicenseModules.Behavior => "السلوك والمواظبة",
            Masar.Schools.ERP.Licensing.Models.LicenseModules.AdvancedReporting => "التقارير المتقدمة",
            _ => module.ToString()
        };
    }
}

<footer class="footer text-muted border-top py-3 text-center bg-light mt-auto">
    <div class="container-fluid">
        <span>© 2026 <strong>نظام مَسَار للمدارس</strong> - جميع الحقوق محفوظة - شركة مسار للبرمجيات mokdadvipr@gmail.com .. 01006765664 (نسخة 1.0.0)</span>
    </div>
</footer>