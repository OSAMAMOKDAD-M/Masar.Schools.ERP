@model Masar.Schools.ERP.Domain.DTOs.CreatePurchaseInvoiceRequest

@{
    ViewData["Title"] = "إنشاء فاتورة شراء";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">إنشاء فاتورة شراء جديدة</h3>
                </div>
                <div class="card-body">
                    <form asp-action="CreatePurchaseInvoice" method="post">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="SupplierId">المورد</label>
                                    <select asp-for="SupplierId" class="form-control" required>
                                        <option value="">اختر المورد</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="PurchaseOrderId">أمر الشراء</label>
                                    <select asp-for="PurchaseOrderId" class="form-control">
                                        <option value="">اختر أمر الشراء (اختياري)</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="InvoiceDate">تاريخ الفاتورة</label>
                                    <input asp-for="InvoiceDate" type="date" class="form-control" required />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="DueDate">تاريخ الاستحقاق</label>
                                    <input asp-for="DueDate" type="date" class="form-control" required />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Discount">الخصم</label>
                                    <input asp-for="Discount" type="number" step="0.01" class="form-control" required />
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label asp-for="Notes">ملاحظات</label>
                            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                        </div>
                        <div class="form-group">
                            <button type="submit" class="btn btn-primary">حفظ</button>
                            <a asp-action="PurchaseInvoices" class="btn btn-secondary">إلغاء</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
