@model Masar.Schools.ERP.Domain.DTOs.CreatePurchaseRequestRequest

@{
    ViewData["Title"] = "إنشاء طلب شراء";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">إنشاء طلب شراء جديد</h3>
                </div>
                <div class="card-body">
                    <form asp-action="CreatePurchaseRequest" method="post">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="SchoolId">المدرسة</label>
                                    <select asp-for="SchoolId" class="form-control" required>
                                        <option value="">اختر المدرسة</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="RequiredBy">التاريخ المطلوب</label>
                                    <input asp-for="RequiredBy" type="date" class="form-control" required />
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="RequestedBy">طالب الطلب</label>
                                    <input asp-for="RequestedBy" class="form-control" required />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="BudgetAmount">المبلغ المطلوب</label>
                                    <input asp-for="BudgetAmount" type="number" step="0.01" class="form-control" required />
                                </div>
                            </div>
                        </div>
                        <div class="form-group">
                            <label asp-for="Purpose">الغرض</label>
                            <input asp-for="Purpose" class="form-control" required />
                        </div>
                        <div class="form-group">
                            <label asp-for="PurposeArabic">الغرض بالعربية</label>
                            <input asp-for="PurposeArabic" class="form-control" required />
                        </div>
                        <div class="form-group">
                            <button type="submit" class="btn btn-primary">حفظ</button>
                            <a asp-action="PurchaseRequests" class="btn btn-secondary">إلغاء</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
