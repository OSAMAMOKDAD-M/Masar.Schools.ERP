@model Masar.Schools.ERP.Domain.DTOs.InventoryTransferDto

@{
    ViewData["Title"] = "تفاصيل عملية النقل";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">تفاصيل عملية النقل - @Model.TransferNumber</h3>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-4">رقم النقل:</dt>
                                <dd class="col-sm-8">@Model.TransferNumber</dd>
                                <dt class="col-sm-4">التاريخ:</dt>
                                <dd class="col-sm-8">@Model.TransferDate.ToString("yyyy-MM-dd")</dd>
                                <dt class="col-sm-4">من المخزن:</dt>
                                <dd class="col-sm-8">@Model.FromWarehouseName</dd>
                                <dt class="col-sm-4">إلى المخزن:</dt>
                                <dd class="col-sm-8">@Model.ToWarehouseName</dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-4">القيمة:</dt>
                                <dd class="col-sm-8">@Model.TotalValue.ToString("C")</dd>
                                <dt class="col-sm-4">العملة:</dt>
                                <dd class="col-sm-8">@Model.Currency</dd>
                                <dt class="col-sm-4">الحالة:</dt>
                                <dd class="col-sm-8">
                                    <span class="badge bg-@(Model.Status == "Completed" ? "success" : Model.Status == "Approved" ? "info" : "warning")">
                                        @Model.StatusArabic
                                    </span>
                                </dd>
                            </dl>
                        </div>
                    </div>
                    <hr />
                    <div class="row">
                        <div class="col-12">
                            <h5>السبب</h5>
                            <p>@Model.Reason</p>
                            <h5>السبب بالعربية</h5>
                            <p>@Model.ReasonArabic</p>
                        </div>
                    </div>
                    @if (Model.Status == "Draft")
                    {
                        <hr />
                        <div class="row">
                            <div class="col-12">
                                <form asp-action="ApproveInventoryTransfer" method="post">
                                    <input type="hidden" name="id" value="@Model.Id" />
                                    <input type="hidden" name="approvedBy" value="System" />
                                    <button type="submit" class="btn btn-success">اعتماد</button>
                                    <a asp-action="InventoryTransfers" class="btn btn-secondary">عودة</a>
                                </form>
                            </div>
                        </div>
                    }
                    else if (Model.Status == "Approved")
                    {
                        <hr />
                        <div class="row">
                            <div class="col-12">
                                <form asp-action="CompleteInventoryTransfer" method="post">
                                    <input type="hidden" name="id" value="@Model.Id" />
                                    <input type="hidden" name="performedBy" value="System" />
                                    <button type="submit" class="btn btn-primary">إكمال النقل</button>
                                    <a asp-action="InventoryTransfers" class="btn btn-secondary">عودة</a>
                                </form>
                            </div>
                        </div>
                    }
                    else
                    {
                        <hr />
                        <a asp-action="InventoryTransfers" class="btn btn-secondary">عودة</a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
