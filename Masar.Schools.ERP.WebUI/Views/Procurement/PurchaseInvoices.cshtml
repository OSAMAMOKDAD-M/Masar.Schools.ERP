@model List<Masar.Schools.ERP.Domain.DTOs.PurchaseInvoiceDto>

@{
    ViewData["Title"] = "فواتير الشراء";
    Layout = "_Layout";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">قائمة فواتير الشراء</h3>
                    <a asp-action="CreatePurchaseInvoice" class="btn btn-primary">
                        <i class="fas fa-plus"></i> إضافة فاتورة جديدة
                    </a>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped">
                            <thead>
                                <tr>
                                    <th>رقم الفاتورة</th>
                                    <th>رقم الفاتورة الضريبية</th>
                                    <th>المورد</th>
                                    <th>تاريخ الفاتورة</th>
                                    <th>تاريخ الاستحقاق</th>
                                    <th>الإجمالي</th>
                                    <th>المدفوع</th>
                                    <th>المتبقي</th>
                                    <th>ZATCA</th>
                                    <th>الحالة</th>
                                    <th>الإجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var invoice in Model)
                                {
                                    <tr>
                                        <td>@invoice.InvoiceNumber</td>
                                        <td>@invoice.TaxInvoiceNumber</td>
                                        <td>@invoice.SupplierName</td>
                                        <td>@invoice.InvoiceDate.ToString("yyyy-MM-dd")</td>
                                        <td>@invoice.DueDate.ToString("yyyy-MM-dd")</td>
                                        <td>@invoice.TotalAmount @invoice.Currency</td>
                                        <td>@invoice.PaidAmount @invoice.Currency</td>
                                        <td>@invoice.RemainingAmount @invoice.Currency</td>
                                        <td>
                                            @if (invoice.IsZatcaApproved)
                                            {
                                                <span class="badge badge-success">معتم</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-secondary">غير معتم</span>
                                            }
                                        </td>
                                        <td>
                                            @switch (invoice.Status)
                                            {
                                                case "Draft":
                                                    <span class="badge badge-secondary">مسودة</span>
                                                    break;
                                                case "Pending":
                                                    <span class="badge badge-warning">قيد الانتظار</span>
                                                    break;
                                                case "Paid":
                                                    <span class="badge badge-success">مدفوع</span>
                                                    break;
                                                case "Partially Paid":
                                                    <span class="badge badge-info">مدفوع جزئياً</span>
                                                    break;
                                                case "Overdue":
                                                    <span class="badge badge-danger">متأخر</span>
                                                    break;
                                                case "Cancelled":
                                                    <span class="badge badge-danger">ملغي</span>
                                                    break;
                                                default:
                                                    <span class="badge badge-secondary">@invoice.Status</span>
                                                    break;
                                            }
                                        </td>
                                        <td>
                                            <a asp-action="PurchaseInvoiceDetails" asp-route-id="@invoice.Id" class="btn btn-sm btn-primary">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            @if (!invoice.IsZatcaApproved)
                                            {
                                                <form asp-action="ApproveZatcaInvoice" asp-route-id="@invoice.Id" method="post" class="d-inline">
                                                    <button type="submit" class="btn btn-sm btn-success" onclick="return confirm('هل أنت متأكد من اعتماد الفاتورة مع ZATCA؟')">
                                                        <i class="fas fa-file-invoice"></i>
                                                    </button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
