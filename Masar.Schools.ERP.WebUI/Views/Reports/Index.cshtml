@model List<ReportDefinition>
@{
    ViewData["Title"] = "التقارير";
}

<div class="row mb-4">
    <div class="col-12">
        <h1 class="h3 mb-3">
            <i class="bi bi-file-earmark-bar-graph"></i> التقارير الإدارية والمالية
        </h1>
        <p class="text-muted">استعراض وتصدير التقارير المتاحة</p>
    </div>
</div>

<div class="row">
    @foreach (var report in Model)
    {
        <div class="col-md-4 mb-3">
            <div class="card h-100">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-file-earmark-text"></i> @report.NameArabic
                    </h5>
                    <p class="card-text text-muted">@report.Description</p>
                    <div class="mt-3">
                        <a href="/Reports/ExportPdf?reportType=@report.Id" class="btn btn-primary btn-sm">
                            <i class="bi bi-file-earmark-pdf"></i> PDF
                        </a>
                        <a href="/Reports/ExportExcel?reportType=@report.Id" class="btn btn-success btn-sm">
                            <i class="bi bi-file-earmark-excel"></i> Excel
                        </a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
