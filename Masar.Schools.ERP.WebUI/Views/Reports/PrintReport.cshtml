@model dynamic
@{
    ViewData["Title"] = "طباعة التقرير";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 20px;
            direction: rtl;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }
        th, td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: right;
        }
        th {
            background-color: #f2f2f2;
            font-weight: bold;
        }
        .header {
            text-align: center;
            margin-bottom: 30px;
        }
        .footer {
            text-align: center;
            margin-top: 30px;
            font-size: 12px;
            color: #666;
        }
        @@media print {
            body {
                margin: 0;
            }
            .no-print {
                display: none;
            }
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>نظام مدارس مسار - تقارير مخصصة</h1>
        <p>تاريخ التقرير: @DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")</p>
    </div>

    <div class="report-content">
        @if (Model != null)
        {
            <table>
                <thead>
                    <tr>
                        @foreach (var column in Model.SelectedColumns)
                        {
                            <th>@column</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Results)
                    {
                        <tr>
                            @foreach (var column in Model.SelectedColumns)
                            {
                                var value = row[column];
                                <td>@(value ?? "-")</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>

            <div style="margin-top: 20px;">
                <p><strong>إجمالي السجلات:</strong> @Model.TotalRecords</p>
            </div>
        }
        else
        {
            <p>لا توجد بيانات للعرض</p>
        }
    </div>

    <div class="footer">
        <p>تم إنشاء هذا التقرير بواسطة نظام مدارس مسار</p>
    </div>

    <div class="no-print" style="text-align: center; margin-top: 30px;">
        <button onclick="window.print()" class="btn btn-primary">طباعة</button>
        <button onclick="window.close()" class="btn btn-secondary">إغلاق</button>
    </div>
</body>
</html>