@section Scripts {
    <script>
        function createRole() {
            const roleName = prompt('أدخل اسم الدور الجديد:');
            if (roleName) {
                alert('تم إنشاء الدور "' + roleName + '" بنجاح!');
            }
        }

        function createUser() {
            alert('جاري فتح نموذج إنشاء المستخدم...');
        }

        function editRole(roleId) {
            alert('جاري فتح محرر الدور #' + roleId);
        }

        function viewPermissions(roleId) {
            alert('جاري فتح عارض الصلاحيات للدور #' + roleId);
        }

        function editUser(userId) {
            alert('جاري فتح محرر المستخدم #' + userId);
        }

        function resetPassword(userId) {
            if (confirm('هل أنت متأكد من إعادة تعيين كلمة المرور للمستخدم #' + userId + '؟')) {
                alert('تم إرسال رابط إعادة تعيين كلمة المرور إلى بريد المستخدم.');
            }
        }
    </script>
}
