@{
    ViewData["Title"] = "الأدوار والصلاحيات";
}

<div class="row mb-4">
    <div class="col-12">
        <h1 class="h3 mb-3">
            <i class="bi bi-shield-lock"></i> الأدوار والصلاحيات
        </h1>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-right"></i> العودة للإعدادات
        </a>
        <button class="btn btn-primary" onclick="createRole()">
            <i class="bi bi-plus-circle"></i> إنشاء دور
        </button>
        <button class="btn btn-success" onclick="createUser()">
            <i class="bi bi-person-plus"></i> إنشاء مستخدم
        </button>
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">أدوار النظام</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>اسم الدور</th>
                                <th>عدد المستخدمين</th>
                                <th>الحالة</th>
                                <th>الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>مدير النظام</td>
                                <td>1</td>
                                <td><span class="status-badge success">نشط</span></td>
                                <td>
                                    <button class="btn btn-sm btn-info" onclick="editRole(1)">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-sm btn-secondary" onclick="viewPermissions(1)">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </td>
                            </tr>
