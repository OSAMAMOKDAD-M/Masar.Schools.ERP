    <script>
        // Auto-open the accordion group containing the active link
        document.addEventListener('DOMContentLoaded', function() {
            const activeLink = document.querySelector('.nav-link.active');
            if (activeLink) {
                // Find the closest accordion-collapse parent
                const accordionCollapse = activeLink.closest('.accordion-collapse');
                if (accordionCollapse) {
                    // Show the accordion group
                    accordionCollapse.classList.add('show');

                    // Find the corresponding accordion button and add the 'not-collapsed' class
                    const accordionButton = document.querySelector(`[data-bs-target="#${accordionCollapse.id}"]`);
                    if (accordionButton) {
                        accordionButton.classList.remove('collapsed');
                        accordionButton.setAttribute('aria-expanded', 'true');
                    }
                }
            }
        });
    </script>

