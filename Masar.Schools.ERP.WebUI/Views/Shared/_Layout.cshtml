@{
    var tenantNameComponent = await Component.InvokeAsync("TenantName");
    var tenantName = tenantNameComponent?.ToString() ?? "نظام مَسَار للمدارس";
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @tenantName</title>
    <link rel="stylesheet" href="~/css/fonts.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/lib/fontawesome/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <script defer src="~/lib/alpinejs/alpine.min.js"></script>
    <style>
        .sidebar {
            padding-top: 0;
            overflow-x: hidden;
            overflow-y: auto;
        }
        .main-content {
            margin-right: 0;
        }
        .sidebar .accordion-button {
            background-color: #212529 !important;
            color: white !important;
            border: none !important;
        }
        .sidebar .accordion-button:not(.collapsed) {
            background-color: #343a40 !important;
            color: white !important;
            box-shadow: none !important;
        }
        .sidebar .accordion-button::after {
            filter: invert(1);
        }
        .sidebar .nav-link {
            color: rgba(255,255,255,.75);
            padding: 0.5rem 1.5rem;
        }
        .sidebar .nav-link:hover {
            color: white;
            background-color: rgba(255,255,255,.1);
        }
        .sidebar .nav-link.active {
            color: #0d6efd;
            background-color: rgba(13, 110, 253, .1);
        }
        .sidebar .nav-link.text-muted {
            color: rgba(255,255,255,.5) !important;
            pointer-events: none;
        }
        .main-content {
            margin-right: 0;
        }
        @@media (max-width: 992px) {
            .sidebar {
                width: 250px;
                transform: translateX(100%);
                transition: transform 0.3s ease-in-out;
            }
            .sidebar.show {
                transform: translateX(0);
            }
            .main-content {
                margin-right: 0;
            }
        }
    
    .accordion-button:not(.collapsed)::after {
        filter: invert(1);
    }
    
    .accordion-button {
        transition: background-color 0.2s ease;
    }
    
    .accordion-button:hover {
        background-color: #343a40 !important;
    }
    
    .nav-link {
        transition: all 0.2s ease;
    }
    
    .nav-link:hover {
        padding-right: 1.75rem !important;
    }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="d-flex">
        <!-- Sidebar -->
        <nav class="sidebar bg-dark text-white flex-shrink-0" style="width: 280px; min-height: 100vh;">
            <div class="sidebar-header p-3 border-bottom border-secondary">
                <a class="navbar-brand text-white text-decoration-none" href="/">
                    <i class="bi bi-building-fill"></i>
                    <span class="fw-bold">@tenantName</span>
                </a>
            </div>

            <div class="accordion accordion-flush" id="sidebarAccordion">
                <!-- المجموعة 1: لوحة التحكم والاتصال الفوري -->
                <div class="accordion-item bg-dark" data-bs-parent="#sidebarAccordion">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed bg-dark text-white" type="button" data-bs-toggle="collapse" data-bs-target="#group1">
                            <i class="bi bi-speedometer2"></i> لوحة التحكم والاتصال
                        </button>
                    </h2>
                    <div id="group1" class="accordion-collapse collapse">
                        <div class="accordion-body p-0">
                            <ul class="nav flex-column">
                                <li class="nav-item">
                                    <a class="nav-link @IsActive("Home", "Index")" asp-controller="Home" asp-action="Index">
                                        <i class="bi bi-house-door"></i> الرئيسية
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @IsActive("Chat", "Index")" asp-controller="Chat" asp-action="Index">
                                        <i class="bi bi-chat-dots"></i> الدردشة
                                        <span class="badge bg-primary ms-auto">SignalR</span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="#" onclick="window.openAiAssistant()" data-bs-toggle="tooltip" title="مساعد الذكاء الاصطناعي">
                                        <i class="bi bi-robot"></i> المساعد الذكي
                                        <span class="badge bg-info ms-auto">AI</span>
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- المجموعة 1.5: المؤسسة والمدارس -->
                <div class="accordion-item bg-dark" data-bs-parent="#sidebarAccordion">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed bg-dark text-white" type="button" data-bs-toggle="collapse" data-bs-target="#group15">
                            <i class="bi bi-building"></i> المؤسسة والمدارس
                        </button>
                    </h2>
                    <div id="group15" class="accordion-collapse collapse">
                        <div class="accordion-body p-0">
                            <ul class="nav flex-column">
                                <li class="nav-item">
                                    <a class="nav-link @IsActive("Tenants", "Index")" asp-controller="Tenants" asp-action="Index">
                                        <i class="bi bi-building"></i> إدارة المؤسسات
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @IsActive("Schools", "Index")" asp-controller="Schools" asp-action="Index">
                                        <i class="bi bi-building"></i> إدارة المدارس
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @IsActive("Classrooms", "Index")" asp-controller="Classrooms" asp-action="Index">
                                        <i class="bi bi-door-open"></i> إدارة الفصول
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @IsActive("GradeLevels", "Index")" asp-controller="GradeLevels" asp-action="Index">
                                        <i class="bi bi-layers"></i> إدارة المراحل
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @IsActive("Sections", "Index")" asp-controller="Sections" asp-action="Index">
                                        <i class="bi bi-collection"></i> إدارة الشعب
                                    </a>
                                </li>
                                @await Component.InvokeAsync("ClassroomsSidebar")
                                <li class="nav-item">
                                    <a class="nav-link @IsActive("Settings", "Index")" asp-controller="Settings" asp-action="Index">
                                        <i class="bi bi-sliders"></i> الإعدادات العامة
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @IsActive("Backups", "Index")" asp-controller="Backups" asp-action="Index">
                                        <i class="bi bi-database"></i> النسخ الاحتياطية
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @IsActive("BackupSettings", "Index")" asp-controller="BackupSettings" asp-action="Index">
                                        <i class="bi bi-gear"></i> إعدادات النسخ
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- المجموعة 1.6: مركز التقارير -->
                <div class="accordion-item bg-dark" data-bs-parent="#sidebarAccordion">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed bg-dark text-white" type="button" data-bs-toggle="collapse" data-bs-target="#group16">
                            <i class="bi bi-file-earmark-bar-graph"></i> مركز التقارير
                        </button>
                    </h2>
                    <div id="group16" class="accordion-collapse collapse">
                        <div class="accordion-body p-0">
                            <ul class="nav flex-column">
                                <li class="nav-item">
                                    <span class="nav-link fw-bold text-muted ps-3">التقارير الرئيسية</span>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @IsActive("Reports", "Index")" asp-controller="Reports" asp-action="Index">
                                        <i class="bi bi-file-earmark-text"></i> جميع التقارير
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <span class="nav-link fw-bold text-muted ps-3">التقارير المخصصة</span>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @IsActive("Reports", "CustomReportBuilder")" asp-controller="Reports" asp-action="CustomReportBuilder">
                                        <i class="bi bi-tools"></i> مُنشئ التقارير المخصصة
                                        <span class="badge bg-success ms-auto">جديد</span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @IsActive("Reports", "SavedReports")" asp-controller="Reports" asp-action="SavedReports">
                                        <i class="bi bi-bookmark"></i> التقارير المحفوظة
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <span class="nav-link fw-bold text-muted ps-3">تقارير الموارد البشرية</span>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @IsActive("HR", "Payroll")" asp-controller="HR" asp-action="Payroll">
                                        <i class="bi bi-cash"></i> تقارير الرواتب
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @IsActive("HR", "Attendance")" asp-controller="HR" asp-action="Attendance">
                                        <i class="bi bi-calendar-check"></i> تقارير الحضور
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <span class="nav-link fw-bold text-muted ps-3">تقارير المخازن</span>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @IsActive("Inventory", "StockReport")" asp-controller="Inventory" asp-action="StockReport">
                                        <i class="bi bi-box-seam"></i> تقرير المخزون
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @IsActive("Inventory", "LowStockReport")" asp-controller="Inventory" asp-action="LowStockReport">
                                        <i class="bi bi-exclamation-triangle"></i> تقرير نقص المخزون
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @IsActive("Inventory", "OverStockReport")" asp-controller="Inventory" asp-action="OverStockReport">
                                        <i class="bi bi-boxes"></i> تقرير زيادة المخزون
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <span class="nav-link fw-bold text-muted ps-3">تقارير المشتريات</span>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @IsActive("Procurement", "ProcurementReport")" asp-controller="Procurement" asp-action="ProcurementReport">
                                        <i class="bi bi-cart"></i> تقرير المشتريات
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @IsActive("Procurement", "FinancialIntegrationReport")" asp-controller="Procurement" asp-action="FinancialIntegrationReport">
                                        <i class="bi bi-currency-dollar"></i> التكامل المالي
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <span class="nav-link fw-bold text-muted ps-3">تقارير مالية</span>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @IsActive("Invoices", "StudentStatement")" asp-controller="Invoices" asp-action="StudentStatement">
                                        <i class="bi bi-receipt"></i> كشف حساب الطالب
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- المجموعة 2: شؤون الطلاب وأولياء الأمور -->
                <div class="accordion-item bg-dark" data-bs-parent="#sidebarAccordion">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed bg-dark text-white" type="button" data-bs-toggle="collapse" data-bs-target="#group2">
                            <i class="bi bi-people"></i> شؤون الطلاب وأولياء الأمور
                        </button>
                    </h2>
                    <div id="group2" class="accordion-collapse collapse">
                        <div class="accordion-body p-0">
                            <ul class="nav flex-column">
                                <li class="nav-item">
                                    <span class="nav-link fw-bold text-muted ps-3">الطلاب</span>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @IsActive("Students", "Index")" asp-controller="Students" asp-action="Index">
                                        <i class="bi bi-list-ul"></i> دليل الطلاب
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @IsActive("Students", "Create")" asp-controller="Students" asp-action="Create">
                                        <i class="bi bi-person-plus"></i> تسجيل طالب جديد
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @IsActive("Students", "Details")" asp-controller="Students" asp-action="Details">
                                        <i class="bi bi-person-vcard"></i> الملف الشامل
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @IsActive("Students", "DigitalCard")" asp-controller="Students" asp-action="DigitalCard">
                                        <i class="bi bi-person-badge"></i> البطاقة الرقمية
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @IsActive("Students", "Promote")" asp-controller="Students" asp-action="Promote">
                                        <i class="bi bi-arrow-up-circle"></i> ترفيع ونقل الفصول
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @IsActive("Students", "Documents")" asp-controller="Students" asp-action="Documents">
                                        <i class="bi bi-folder"></i> أرشيف المستندات
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @IsActive("Students", "Edit")" asp-controller="Students" asp-action="Edit">
                                        <i class="bi bi-pencil-square"></i> تعديل بيانات الطالب
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @IsActive("Students", "AcademicRecord")" asp-controller="Students" asp-action="AcademicRecord">
                                        <i class="bi bi-journal-bookmark"></i> السجل الأكاديمي
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @IsActive("Students", "AttendanceAnalysis")" asp-controller="Students" asp-action="AttendanceAnalysis">
                                        <i class="bi bi-graph-up"></i> تحليل الحضور
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @IsActive("Students", "ImportFromExcel")" asp-controller="Students" asp-action="ImportFromExcel">
                                        <i class="bi bi-file-earmark-excel"></i> استيراد من Excel
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <span class="nav-link fw-bold text-muted ps-3">أولياء الأمور</span>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @IsActive("Guardians", "Index")" asp-controller="Guardians" asp-action="Index">
                                        <i class="bi bi-person-hearts"></i> دليل أولياء الأمور
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @IsActive("Guardians", "Create")" asp-controller="Guardians" asp-action="Create">
                                        <i class="bi bi-person-plus"></i> تسجيل ولي أمر
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @IsActive("Guardians", "Details")" asp-controller="Guardians" asp-action="Details">
                                        <i class="bi bi-person-vcard"></i> ملف ولي الأمر
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @IsActive("Guardians", "LinkStudent")" asp-controller="Guardians" asp-action="LinkStudent">
                                        <i class="bi bi-link-45deg"></i> ربط الأبناء
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- المجموعة 3: الكادر التعليمي والموارد البشرية -->
                <div class="accordion-item bg-dark" data-bs-parent="#sidebarAccordion">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed bg-dark text-white" type="button" data-bs-toggle="collapse" data-bs-target="#group3">
                            <i class="bi bi-person-workspace"></i> الكادر التعليمي والموارد البشرية
                        </button>
                    </h2>
                    <div id="group3" class="accordion-collapse collapse">
                        <div class="accordion-body p-0">
                            <ul class="nav flex-column">
                                <li class="nav-item">
                                    <a class="nav-link @IsActive("Employees", "Index")" asp-controller="Employees" asp-action="Index">
                                        <i class="bi bi-people"></i> سجل المعلمين والموظفين
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @IsActive("Employees", "Create")" asp-controller="Employees" asp-action="Create">
                                        <i class="bi bi-person-plus"></i> إضافة موظف
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @IsActive("Employees", "TeacherScheduleIndex")" asp-controller="Employees" asp-action="TeacherScheduleIndex">
                                        <i class="bi bi-calendar3"></i> جدول الحصص
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @IsActive("Employees", "Payroll")" asp-controller="Employees" asp-action="Payroll">
                                        <i class="bi bi-cash-stack"></i> مسير المرتبات
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @IsActive("Employees", "Leaves")" asp-controller="Employees" asp-action="Leaves">
                                        <i class="bi bi-calendar-x"></i> الإجازات
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @IsActive("Employees", "LeaveBalance")" asp-controller="Employees" asp-action="LeaveBalance">
                                        <i class="bi bi-wallet2"></i> رصيد الإجازات
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- المجموعة 3.5: نظام الموارد البشرية المتقدم -->
                <div class="accordion-item bg-dark" data-bs-parent="#sidebarAccordion">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed bg-dark text-white" type="button" data-bs-toggle="collapse" data-bs-target="#group35">
                            <i class="bi bi-person-workspace"></i> نظام الموارد البشرية المتقدم
                        </button>
                    </h2>
                    <div id="group35" class="accordion-collapse collapse">
                        <div class="accordion-body p-0">
                            <ul class="nav flex-column">
                                <li class="nav-item">
                                    <a class="nav-link @IsActive("HR", "Dashboard")" asp-controller="HR" asp-action="Dashboard">
                                        <i class="bi bi-speedometer2"></i> لوحة تحكم HR
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @IsActive("HR", "Contracts")" asp-controller="HR" asp-action="Contracts">
                                        <i class="bi bi-file-earmark-text"></i> إدارة العقود
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @IsActive("HR", "Payroll")" asp-controller="HR" asp-action="Payroll">
                                        <i class="bi bi-cash-coin"></i> نظام الرواتب المتقدم
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @IsActive("HR", "Attendance")" asp-controller="HR" asp-action="Attendance">
                                        <i class="bi bi-fingerprint"></i> الحضور البصري
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @IsActive("HR", "Gratuity")" asp-controller="HR" asp-action="Gratuity">
                                        <i class="bi bi-gift"></i> مكافأة نهاية الخدمة
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link @IsActive("HR", "ImportAttendance")" asp-controller="HR" asp-action="ImportAttendance">
                                        <i class="bi bi-upload"></i> استيراد الحضور البصري
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- المجموعة 4: الاتصالات والمراسلات -->
                <div class="accordion-item bg-dark" data-bs-parent="#sidebarAccordion">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed bg-dark text-white" type="button" data-bs-toggle="collapse" data-bs-target="#group35">
                            <i class="bi bi-envelope"></i> الاتصالات والمراسلات
                        </button>
                    </h2>
                    <div id="group35" class="accordion-collapse collapse">
                        <div class="accordion-body p-0">
                            <ul class="nav flex-column">
                                <li class="nav-item">
                                    <a class="nav-link @IsActive("Communication", "Index")" asp-controller="Communication" asp-action="Index">
                                        <i class="bi bi-chat-dots"></i> نظام المراسلات
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- المجموعة 3.6: الإنذار المبكر -->
                <div class="accordion-item bg-dark" data-bs-parent="#sidebarAccordion">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed bg-dark text-white" type="button" data-bs-toggle="collapse" data-bs-target="#group36">
                            <i class="bi bi-exclamation-triangle"></i> الإنذار المبكر
                        </button>
                    </h2>
                    <div id="group36" class="accordion-collapse collapse">
                        <div class="accordion-body p-0">
                            <ul class="nav flex-column">
                                <li class="nav-item">
                                    <a class="nav-link @IsActive("EarlyWarning", "Index")" asp-controller="EarlyWarning" asp-action="Index">
                                        <i class="bi bi-graph-up-arrow"></i> مؤشر الخطر للطلاب
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- المجموعة 4: الحضور والغياب والمناداة -->
                <div class="accordion-item bg-dark" data-bs-parent="#sidebarAccordion">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed bg-dark text-white" type="button" data-bs-toggle="collapse" data-bs-target="#group4">
                            <i class="bi bi-calendar-check"></i> الحضور والمناداة
                        </button>
                    </h2>
                    <div id="group4" class="accordion-collapse collapse">
                        <div class="accordion-body p-0">
                            <ul class="nav flex-column">
                                <li class="nav-item">
                                    <span class="nav-link fw-bold text-muted ps-3">الحضور والغياب</span>
                                </li>
