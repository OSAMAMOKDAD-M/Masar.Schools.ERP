@model StudentAccount
@{
    ViewData["Title"] = "إنشاء حساب طالب";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col-md-12">
            <h2 class="text-end mb-3">إنشاء حساب طالب</h2>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-right"></i> العودة لحسابات الطلاب
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0">بيانات الحساب</h5>
                </div>
                <div class="card-body">
                    <form asp-action="CreateAccount" method="post">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">الطالب</label>
                                <select name="studentId" class="form-select" required>
                                    <option value="">اختر الطالب</option>
                                    @if (ViewBag.Students != null)
                                    {
                                        var students = ViewBag.Students as System.Collections.Generic.IList<Masar.Schools.ERP.Domain.Entities.Student>;
                                        if (students != null)
                                        {
                                            @foreach (var student in students)
                                            {
                                                <option value="@student.Id">@student.FullNameArabic - @student.StudentNumber</option>
                                            }
                                        }
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">رقم الحساب</label>
                                <input type="text" class="form-control" readonly placeholder="سيتم توليده تلقائياً">
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">الرصيد الافتتاحي</label>
                                <input type="number" name="initialBalance" class="form-control" value="0" step="0.01">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">الحالة</label>
                                <select name="status" class="form-select">
                                    <option value="Active">نشط</option>
                                    <option value="Inactive">غير نشط</option>
                                    <option value="Suspended">معلق</option>
                                </select>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">ملاحظات</label>
                            <textarea name="notes" class="form-control" rows="3"></textarea>
                        </div>

                        <div class="form-check mb-3">
                            <input class="form-check-input" type="checkbox" name="isVatExempt" id="isVatExempt">
                            <label class="form-check-label" for="isVatExempt">
                                معفى من ضريبة القيمة المضافة
                            </label>
                        </div>

                        <div class="mb-3" id="vatExemptionCodeContainer" style="display: none;">
                            <label class="form-label">رمز الإعفاء من الضريبة</label>
                            <input type="text" name="vatExemptionCode" class="form-control" placeholder="مثال: B-123456789">
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> إنشاء الحساب
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="fas fa-times"></i> إلغاء
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h5 class="mb-0">معلومات مهمة</h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i>
                        <strong>ملاحظات مهمة:</strong>
                        <ul class="mb-0 mt-2">
                            <li>رقم الحساب سيتم توليده تلقائياً</li>
                            <li>يمكن تعديل معلومات الحساب لاحقاً</li>
                            <li>إذا كان الطالب معفى من الضريبة، يجب إدخال رمز الإعفاء</li>
                        </ul>
                    </div>

                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle"></i>
                        <strong>تنبيه:</strong>
                        <p class="mb-0 mt-2">
                            تأكد من اختيار الطالب الصحيح قبل إنشاء الحساب.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('isVatExempt').addEventListener('change', function() {
            document.getElementById('vatExemptionCodeContainer').style.display = this.checked ? 'block' : 'none';
        });
    </script>
}
