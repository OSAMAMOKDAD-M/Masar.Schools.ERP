@model List<ClassRoom>
@{
    ViewData["Title"] = "Promote Students";
    var currentAcademicYear = ViewBag.CurrentAcademicYear;
}

<div class="row mb-4">
    <div class="col-12">
        <h1 class="h3 mb-3">
            <i class="bi bi-arrow-up-circle"></i> Promote Students
        </h1>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-right"></i> Back to Students
        </a>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <form asp-action="Promote" method="post">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Current Academic Year: @currentAcademicYear - @(currentAcademicYear + 1)</label>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Source Class (Current)</label>
                            <select name="SourceClassRoomId" class="form-select" required>
                                <option value="">Select Source Class</option>
                                @foreach (var classRoom in Model)
                                {
                                    <option value="@classRoom.Id">
                                        @classRoom.Branch?.NameArabic - @classRoom.NameArabic (Grade @classRoom.GradeLevelLegacy)
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Target Class (Next Grade)</label>
                            <select name="TargetClassRoomId" class="form-select" required>
                                <option value="">Select Target Class</option>
                                @foreach (var classRoom in Model)
                                {
                                    <option value="@classRoom.Id">
                                        @classRoom.Branch?.NameArabic - @classRoom.NameArabic (Grade @classRoom.GradeLevelLegacy)
                                    </option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i>
                        This action will move all students from the source class to the target class. Make sure you have selected the correct classes before proceeding.
                    </div>

                    <div class="row">
                        <div class="col-12">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle"></i> Promote Students
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-x-circle"></i> Cancel
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">Available Classes</h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Branch</th>
                                <th>Class Name</th>
                                <th>Grade Level</th>
                                <th>Section</th>
                                <th>Capacity</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var classRoom in Model)
                            {
                                <tr>
                                    <td>@classRoom.Branch?.NameArabic</td>
                                    <td>@classRoom.NameArabic</td>
                                    <td>@classRoom.GradeLevelLegacy</td>
                                    <td>@classRoom.SectionLegacy</td>
                                    <td>@classRoom.Capacity</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
