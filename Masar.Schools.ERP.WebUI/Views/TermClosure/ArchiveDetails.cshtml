@model Masar.Schools.ERP.Domain.DTOs.TermArchiveDto
@{
    ViewData["Title"] = "تفاصيل الأرشيف";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">تفاصيل الأرشيف - @Model.TermNameArabic</h3>
                    <div class="card-tools">
                        <a href="@Url.Action("Archives", "TermClosure")" class="btn btn-secondary">
                            <i class="fas fa-arrow-right"></i> العودة
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="info-box bg-info">
                                <span class="info-box-icon"><i class="fas fa-calendar-alt"></i></span>
                                <div class="info-box-content">
                                    <span class="info-box-text">اسم الفصل</span>
                                    <span class="info-box-number">@Model.TermNameArabic</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="info-box bg-secondary">
                                <span class="info-box-icon"><i class="fas fa-archive"></i></span>
                                <div class="info-box-content">
                                    <span class="info-box-text">الحالة</span>
                                    <span class="info-box-number">@Model.StatusArabic</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-4">
                        <div class="col-md-12">
                            <div class="card">
                                <div class="card-header">
                                    <h4 class="card-title">معلومات الأرشيف</h4>
                                </div>
                                <div class="card-body">
                                    <table class="table table-bordered">
                                        <tr>
                                            <th>اسم الفصل (إنجليزي)</th>
                                            <td>@Model.TermName</td>
                                        </tr>
                                        <tr>
                                            <th>اسم الفصل (عربي)</th>
                                            <td>@Model.TermNameArabic</td>
                                        </tr>
                                        <tr>
                                            <th>المدرسة</th>
                                            <td>@Model.SchoolName</td>
                                        </tr>
                                        <tr>
                                            <th>تاريخ الإغلاق</th>
                                            <td>@Model.ClosingDate.ToString("yyyy-MM-dd HH:mm")</td>
                                        </tr>
                                        <tr>
                                            <th>عدد الطلاب المؤرشفين</th>
                                            <td>@Model.ArchivedStudentsCount</td>
                                        </tr>
                                        <tr>
                                            <th>عدد الدرجات المؤرشفة</th>
                                            <td>@Model.ArchivedGradesCount</td>
                                        </tr>
                                        <tr>
                                            <th>إجمالي الفواتير المؤرشفة</th>
                                            <td>@Model.ArchivedInvoicesTotal.ToString("N2") ريال</td>
                                        </tr>
                                        <tr>
                                            <th>تاريخ الأرشفة</th>
                                            <td>@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-4">
                        <div class="col-md-12">
                            <div class="alert alert-warning">
                                <h5><i class="fas fa-exclamation-triangle"></i> تحذير</h5>
                                <p>الأرشيف يحتوي على نسخة كاملة من سجلات الفصل الدراسي. لا يمكن حذف الأرشيف إلا من قبل مدير النظام.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
