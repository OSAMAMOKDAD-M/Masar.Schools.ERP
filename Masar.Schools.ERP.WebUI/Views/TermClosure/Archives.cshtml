@model List<Masar.Schools.ERP.Domain.DTOs.TermArchiveDto>
@{
    ViewData["Title"] = "الأرشيفات";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">أرشيفات الفصول الدراسية</h3>
                    <div class="card-tools">
                        <a href="@Url.Action("Index", "TermClosure")" class="btn btn-secondary">
                            <i class="fas fa-arrow-right"></i> العودة
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    @if (Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped">
                                <thead>
                                    <tr>
                                        <th>اسم الفصل</th>
                                        <th>المدرسة</th>
                                        <th>تاريخ الإغلاق</th>
                                        <th>عدد الطلاب</th>
                                        <th>عدد الدرجات</th>
                                        <th>إجمالي الفواتير</th>
                                        <th>الحالة</th>
                                        <th>الإجراءات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var archive in Model)
                                    {
                                        <tr>
                                            <td>@archive.TermNameArabic</td>
                                            <td>@archive.SchoolName</td>
                                            <td>@archive.ClosingDate.ToString("yyyy-MM-dd HH:mm")</td>
                                            <td>@archive.ArchivedStudentsCount</td>
                                            <td>@archive.ArchivedGradesCount</td>
                                            <td>@archive.ArchivedInvoicesTotal.ToString("N2") ريال</td>
                                            <td>
                                                <span class="badge bg-secondary">@archive.StatusArabic</span>
                                            </td>
                                            <td>
                                                <a href="@Url.Action("ArchiveDetails", "TermClosure", new { id = archive.Id })" class="btn btn-info btn-sm">
                                                    <i class="fas fa-eye"></i> عرض
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            لا توجد أرشيفات حالياً
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
