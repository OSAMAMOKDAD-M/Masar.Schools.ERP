@model Masar.Schools.ERP.WebUI.Controllers.TermClosureIndexViewModel
@{
    ViewData["Title"] = "إغلاق الفصول الدراسية";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">إغلاق الفصول الدراسية</h3>
                </div>
                <div class="card-body">
                    <!-- Active Terms Section -->
                    <h4>الفصول النشطة</h4>
                    @if (Model.ActiveTerms.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped">
                                <thead>
                                    <tr>
                                        <th>اسم الفصل</th>
                                        <th>المدرسة</th>
                                        <th>تاريخ البدء</th>
                                        <th>تاريخ الانتهاء</th>
                                        <th>الحالة</th>
                                        <th>الإجراءات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var term in Model.ActiveTerms)
                                    {
                                        <tr>
                                            <td>@term.TermNameArabic</td>
                                            <td>@term.School?.NameArabic</td>
                                            <td>@term.StartDate.ToString("yyyy-MM-dd")</td>
                                            <td>@term.EndDate.ToString("yyyy-MM-dd")</td>
                                            <td>
                                                <span class="badge bg-success">نشط</span>
                                            </td>
                                            <td>
                                                <a href="@Url.Action("Close", "TermClosure", new { id = term.Id })" class="btn btn-warning">
                                                    <i class="fas fa-lock"></i> إغلاق الفصل
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            لا توجد فصول نشطة حالياً
                        </div>
                    }

                    <hr />

                    <!-- Archives Section -->
                    <h4>الأرشيفات</h4>
                    @if (Model.Archives.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped">
                                <thead>
                                    <tr>
                                        <th>اسم الفصل</th>
                                        <th>المدرسة</th>
                                        <th>تاريخ الإغلاق</th>
                                        <th>عدد الطلاب</th>
                                        <th>إجمالي الفواتير</th>
                                        <th>الحالة</th>
                                        <th>الإجراءات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var archive in Model.Archives)
                                    {
                                        <tr>
                                            <td>@archive.TermNameArabic</td>
                                            <td>@archive.SchoolName</td>
                                            <td>@archive.ClosingDate.ToString("yyyy-MM-dd")</td>
                                            <td>@archive.ArchivedStudentsCount</td>
                                            <td>@archive.ArchivedInvoicesTotal.ToString("N2") ريال</td>
                                            <td>
                                                <span class="badge bg-secondary">@archive.StatusArabic</span>
                                            </td>
                                            <td>
                                                <a href="@Url.Action("ArchiveDetails", "TermClosure", new { id = archive.Id })" class="btn btn-info btn-sm">
                                                    <i class="fas fa-eye"></i> عرض
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            لا توجد أرشيفات حالياً
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
