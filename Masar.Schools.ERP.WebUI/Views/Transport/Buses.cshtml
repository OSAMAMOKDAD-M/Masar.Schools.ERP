@model List<Masar.Schools.ERP.Domain.DTOs.BusDto>
@{
    ViewData["Title"] = "إدارة الحافلات";
    Layout = "_Layout";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">إدارة الحافلات</h3>
                    <div class="card-tools">
                        <a href="@Url.Action("CreateBus", "Transport")" class="btn btn-primary">
                            <i class="fas fa-plus"></i> إضافة حافلة جديدة
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered table-striped" id="busesTable">
                            <thead>
                                <tr>
                                    <th>رقم الحافلة</th>
                                    <th>رقم اللوحة</th>
                                    <th>السعة</th>
                                    <th>النوع</th>
                                    <th>الحالة</th>
                                    <th>السائق المعين</th>
                                    <th>المشرف المعين</th>
                                    <th>تاريخ الصيانة القادمة</th>
                                    <th>الإجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Any())
                                {
                                    @foreach (var bus in Model)
                                    {
                                        <tr>
                                            <td>@bus.BusNumber</td>
                                            <td>@bus.PlateNumber</td>
                                            <td>@bus.Capacity</td>
                                            <td>@bus.Type</td>
                                            <td>
                                                @if (bus.Status == "Active")
                                                {
                                                    <span class="badge badge-success">نشط</span>
                                                }
                                                else if (bus.Status == "Maintenance")
                                                {
                                                    <span class="badge badge-warning">صيانة</span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-danger">غير نشط</span>
                                                }
                                            </td>
                                            <td>@(bus.DriverName ?? "غير معين")</td>
                                            <td>@(bus.SupervisorName ?? "غير معين")</td>
                                            <td>@(bus.NextMaintenanceDate?.ToString("yyyy-MM-dd") ?? "غير محدد")</td>
                                            <td>
                                                <a href="@Url.Action("EditBus", "Transport", new { id = bus.Id })" class="btn btn-sm btn-info">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a href="@Url.Action("DeleteBus", "Transport", new { id = bus.Id })" class="btn btn-sm btn-danger" onclick="return confirm('هل أنت متأكد من حذف هذه الحافلة؟')">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="9" class="text-center">لا توجد حافلات مسجلة</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.10.24/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.10.24/js/dataTables.bootstrap4.min.js"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/1.10.24/css/dataTables.bootstrap4.min.css" />
    <script>
        // Wait for jQuery to be loaded
        document.addEventListener('DOMContentLoaded', function() {
            if (typeof $ !== 'undefined') {
                $(document).ready(function() {
                    $('#busesTable').DataTable({
                        "language": {
                            "sEmptyTable": "لا توجد بيانات",
                            "sInfo": "عرض _START_ إلى _END_ من _TOTAL_ سجل",
                            "sInfoEmpty": "عرض 0 إلى 0 من 0 سجل",
                            "sInfoFiltered": "(مفلترة من _MAX_ سجل)",
                            "sInfoPostFix": "",
                            "sInfoThousands": ",",
                            "sLengthMenu": "عرض _MENU_ سجلات",
                            "sLoadingRecords": "جاري التحميل...",
                            "sProcessing": "جاري المعالجة...",
                            "sSearch": "بحث:",
                            "sZeroRecords": "لا توجد نتائج",
                            "oPaginate": {
                                "sFirst": "الأول",
                                "sLast": "الأخير",
                                "sNext": "التالي",
                                "sPrevious": "السابق"
                            },
                            "oAria": {
                                "sSortAscending": ": تفعيل لترتيب العمود تصاعدياً",
                                "sSortDescending": ": تفعيل لترتيب العمود تنازلياً"
                            }
                        },
                        "order": [[0, "asc"]]
                    });
                });
            } else {
                console.error('jQuery is not loaded');
            }
        });
    </script>
}
