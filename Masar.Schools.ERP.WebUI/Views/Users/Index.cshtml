@model Masar.Schools.ERP.WebUI.Controllers.UsersIndexViewModel
@{
    ViewData["Title"] = "إدارة المستخدمين";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-end">إدارة المستخدمين</h2>
        <div>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> إضافة مستخدم جديد
            </a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="bi bi-people"></i> قائمة المستخدمين</h5>
        </div>
        <div class="card-body">
            @if (Model.Users.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover text-end">
                        <thead class="table-light">
                            <tr>
                                <th>الاسم</th>
                                <th>البريد الإلكتروني</th>
                                <th>رقم الهاتف</th>
                                <th>الأدوار</th>
                                <th>الحالة</th>
                                <th>الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model.Users)
                            {
                                <tr>
                                    <td>@user.FullNameArabic ?? user.FullName</td>
                                    <td>@user.Email</td>
                                    <td>@user.PhoneNumber</td>
                                    <td>
                                        @if (user.UserRoles.Any())
                                        {
                                            var userRoleIds = user.UserRoles.Select(ur => ur.RoleId).ToList();
                                            var userRolesList = Model.Roles.Where(r => userRoleIds.Contains(r.Id)).ToList();
                                            foreach (var role in userRolesList)
                                            {
                                                <span class="badge bg-info me-1">@role.Name</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">لا توجد أدوار</span>
                                        }
                                    </td>
                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="badge bg-success">نشط</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">غير نشط</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="ManagePermissions" asp-route-id="@user.Id" class="btn btn-warning" title="الصلاحيات">
                                                <i class="bi bi-key"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-info" title="تعديل">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@user.Id" class="btn btn-danger" title="حذف">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4">
                    <i class="bi bi-people fs-1 text-muted"></i>
                    <p class="text-muted mt-2">لا يوجد مستخدمون</p>
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i> إضافة مستخدم جديد
                    </a>
                </div>
            }
        </div>
    </div>
</div>
